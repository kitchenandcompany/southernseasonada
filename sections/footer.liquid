<script
  type="application/json"
  data-section-type="footer"
  data-section-id="{{ section.id }}"
>
</script>

{%- assign locale_selector = false -%}
{%- assign currency_selector = false -%}

{%- if section.settings.show_currency_selector and shop.enabled_currencies.size > 1 -%}
  {%- assign currency_selector = true -%}
{%- endif -%}

{%- if section.settings.show_locale_selector and shop.published_locales.size > 1 -%}
  {%- assign locale_selector = true -%}
{%- endif -%}

{% comment %} 
  Inline CSS to ensure visual arrows only show on mobile 
  and buttons appear as normal headings on desktop.
{% endcomment %}
<style>
  .footer_menu button.footer-title-toggle,
  .footer_content button.footer-title-toggle {
    background-color: transparent;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }
  
  .footer-title-toggle .icon-down-arrow {
    display: none; /* Hidden on desktop by default */
  }

  @media only screen and (max-width: 798px) {
    .footer-title-toggle .icon-down-arrow {
      display: inline-block; /* Shown on mobile screens */
    }
  }

  /* Improve Follow on Shop button contrast in footer. */
  .footer__follow-on-shop {
    filter: brightness(0.75) contrast(1.2);
  }

  .footer-heading h2.h6 {
    margin: 0;
    padding: 0;
    border: 0;
    font: inherit;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
  }

  .footer-heading h2.h6 .footer-title-toggle {
    width: 100%;
  }

  .guest-service-hours .toggle_content {
    padding-top: 12px;
  }
  .guest-service-hours__row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 14px;
  }
  .guest-service-hours__row:last-child {
    margin-bottom: 0;
  }
  .guest-service-hours__icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    color: {{ settings.btn_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .guest-service-hours__icon svg {
    width: 18px;
    height: 18px;
    display: block;
  }
  .guest-service-hours__body {
    flex: 1;
    min-width: 0;
    line-height: 1.35;
  }
  .guest-service-hours__body a {
    color: inherit;
    text-decoration: none;
  }
  .guest-service-hours__body a:hover,
  .guest-service-hours__body a:focus {
    color: {{ settings.link_color }};
    text-decoration: underline;
  }
  .guest-service-hours__grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 12px;
    row-gap: 4px;
    align-items: baseline;
  }
  .guest-service-hours__day {
    font-weight: 700;
  }
  .guest-service-hours__time {
    text-align: right;
  }
</style>

{% capture a11y_site_footer %}{{ 'general.accessibility.site_footer' | t }}{% endcapture %}
<footer class="footer">
  <section class="section">
    <div class="container footer-menu-wrap">
      {% for block in section.blocks %}
        <div class="{% if forloop.length >= 5 %}one-fifth column{% elsif forloop.length == 4 %}one-fourth column{% elsif forloop.length == 3 %}one-third column{% elsif forloop.length == 2 %}one-half column{% endif %} medium-down--one-whole" {{ block.shopify_attributes }}>
          {% if block.type == 'logo' %}
            <div class="text-align--{{block.settings.text_align}}">
              {% if block.settings.image %}
                <img alt="{{ block.settings.image.alt | escape }}"
                     class="footer-logo lazyload {{ settings.image_loading_style }}"
                     data-sizes="25vw"
                     style="object-fit: cover; object-position: {{ block.settings.image.presentation.focal_point }}; max-width: {{- block.settings.image.width -}}px"
                     data-src="{{ block.settings.image | img_url: '2048x' }}"
                     data-srcset="{{ block.settings.image | img_url: '200x' }} 200w,
                                  {{ block.settings.image | img_url: '300x' }} 300w,
                                  {{ block.settings.image | img_url: '400x' }} 400w,
                                  {{ block.settings.image | img_url: '500x' }} 500w,
                                  {{ block.settings.image | img_url: '600x' }} 600w,
                                  {{ block.settings.image | img_url: '1000x' }} 1000w"
                />
              {% else %}
                <div class="logo">{{ shop.name }}</div>
              {% endif %}
            </div>
          {% elsif block.type == 'newsletter' %}
            <div class="newsletter_section">
              {% if block.settings.title != blank %}
                <h2 class="h6">{{ block.settings.title }}</h2>
              {% endif %}

              {% if block.settings.newsletter_text != blank %}
                {{ block.settings.newsletter_text }}
              {% endif %}

              <div class="newsletter">
                <span class="message" aria-live="polite"></span>

                {% if settings.mailchimp_link != blank %}
                  <form action="{{ settings.mailchimp_link }}" method="post" name="mc-embedded-subscribe-form" id="contact_form" target="_blank">
                    
                    {% if block.settings.show_firstname %}
                      <label for="newsletter-fname-{{ block.id }}" class="visually-hidden">{{ 'general.newsletter_form.subscriber_first_name' | t }}</label>
                      <input id="newsletter-fname-{{ block.id }}" type="text" class="firstName" name="FNAME" placeholder="{{ 'general.newsletter_form.subscriber_first_name' | t }}">
                    {% endif %}

                    {% if block.settings.show_lastname %}
                      <label for="newsletter-lname-{{ block.id }}" class="visually-hidden">{{ 'general.newsletter_form.subscriber_last_name' | t }}</label>
                      <input id="newsletter-lname-{{ block.id }}" type="text" name="LNAME" placeholder="{{ 'general.newsletter_form.subscriber_last_name' | t }}">
                    {% endif %}

                    <label for="newsletter-email-{{ block.id }}" class="visually-hidden">{{ 'general.newsletter_form.placeholder' | t }}</label>
                    <input id="newsletter-email-{{ block.id }}" type="email" name="EMAIL" class="contact_email" required placeholder="{{ 'general.newsletter_form.placeholder' | t }}">

                    <input type="submit" value="{{ 'general.newsletter_form.submit' | t }}" class="global-button global-button--primary newsletter-form__sign-up" name="subscribe" />
                  </form>
                {% else %}
                  {% form 'customer' %}
                    {% if form.posted_successfully? %}
                      <p role="alert"><em>{{ 'general.newsletter_form.success_text' | t }}</em></p>
                    {% elsif form.errors %}
                      <div role="alert">
                        {% for field in form.errors %}
                          <p><em>{{ field }} - {{ form.errors.messages[field] }}</em></p>
                        {% endfor %}
                      </div>
                    {% endif %}

                    <input type="hidden" name="contact[tags]" value="prospect,newsletter"/>

                    {% if block.settings.show_firstname %}
                      <label for="newsletter-form-fname-{{ block.id }}" class="visually-hidden">{{ 'general.newsletter_form.subscriber_first_name' | t }}</label>
                      <input id="newsletter-form-fname-{{ block.id }}" type="text" class="firstName" name="contact[first_name]" placeholder="{{ 'general.newsletter_form.subscriber_first_name' | t }}" />
                    {% endif %}

                    {% if block.settings.show_lastname %}
                      <label for="newsletter-form-lname-{{ block.id }}" class="visually-hidden">{{ 'general.newsletter_form.subscriber_last_name' | t }}</label>
                      <input id="newsletter-form-lname-{{ block.id }}" type="text" name="contact[last_name]" placeholder="{{ 'general.newsletter_form.subscriber_last_name' | t }}" />
                    {% endif %}

                    <input type="hidden" name="challenge" value="false" />
                    
                    <label for="newsletter-form-email-{{ block.id }}" class="visually-hidden">{{ 'general.newsletter_form.placeholder' | t }}</label>
                    <input id="newsletter-form-email-{{ block.id }}" type="email" class="contact_email" name="contact[email]" required placeholder="{{ 'general.newsletter_form.placeholder' | t }}" />
                    
                    <input type='submit' class="global-button global-button--primary newsletter-form__sign-up" value="{{ 'general.newsletter_form.submit' | t }}" />
                  {% endform %}
                {% endif %}
              </div>

              {% if block.settings.show_social %}
                {% render 'social-icons' %}
              {% endif %}
            </div>
          {% elsif block.type == 'link_list' %}
            <div class="footer_menu">
              {% if block.settings.menu != blank %}
                <div class="footer-heading">
                  <h2 class="h6">
                    {% capture a11y_toggle_menu %}{{ 'general.accessibility.toggle_menu' | t: menu: linklists[block.settings.menu].title }}{% endcapture %}
                    {% capture fb_toggle_menu %}Toggle {{ linklists[block.settings.menu].title }} menu{% endcapture %}
                    <button type="button" class="footer-title-toggle" aria-label="{{ linklists[block.settings.menu].title }}">
                      {{ linklists[block.settings.menu].title }}
                      <span class="icon-down-arrow" aria-hidden="true"></span>
                    </button>
                  </h2>
                </div>

                <div class="toggle_content">
                  <ul>
                    {% for link in linklists[block.settings.menu].links %}
                      <li>
                        <p><a href="{{ link.url }}">{{ link.title }}</a></p>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% else %}
                <div class="footer-heading">
                  <h2 class="h6">
                    <button type="button" class="footer-title-toggle" aria-expanded="false">
                      Menu title
                      <span class="icon-down-arrow" aria-hidden="true"></span>
                    </button>
                  </h2>
                </div>

                <div class="toggle_content">
                  <ul>
                    <li><p>{{ 'homepage.onboarding.no_content' | t }}</p></li>
                  </ul>
                </div>
              {% endif %}
            </div>
          {% elsif block.type == 'text' %}
            <div class="footer_content footer-text {% if block.settings.title == blank %}no-footer-title{% endif %}">
              {% if block.settings.title != blank %}
                <div class="footer-heading">
                  <h2 class="h6">
                    {% capture a11y_toggle_section %}{{ 'general.accessibility.toggle_section' | t: title: block.settings.title }}{% endcapture %}
                    {% capture fb_toggle_section %}Toggle {{ block.settings.title }} section{% endcapture %}
                    <button type="button" class="footer-title-toggle" aria-label="{% render 'a11y-missing-fallback', text: a11y_toggle_section, fallback: fb_toggle_section %}" aria-expanded="false">
                      {{ block.settings.title }}
                      <span class="icon-down-arrow" aria-hidden="true"></span>
                    </button>
                  </h2>
                </div>
              {% endif %}

              {% if block.settings.content %}
                <div class="toggle_content">
                  {{ block.settings.content }}
                </div>
              {% endif %}
            </div>
          {% elsif block.type == 'page' %}
            <div class="footer_content footer-text">
              {% if block.settings.page != blank %}
                <div class="footer-heading">
                  <h2 class="h6">
                    {% capture a11y_toggle_page %}{{ 'general.accessibility.toggle_section' | t: title: pages[block.settings.page].title }}{% endcapture %}
                    {% capture fb_toggle_page %}Toggle {{ pages[block.settings.page].title }} section{% endcapture %}
                    <button type="button" class="footer-title-toggle" aria-label="{% render 'a11y-missing-fallback', text: a11y_toggle_page, fallback: fb_toggle_page %}" aria-expanded="false">
                      {{ pages[block.settings.page].title }}
                      <span class="icon-down-arrow" aria-hidden="true"></span>
                    </button>
                  </h2>
                </div>

                <div class="toggle_content rte">
                  {{ pages[block.settings.page].content }}
                </div>
              {% else %}
                <div class="footer-heading">
                  <h2 class="h6">
                    <button type="button" class="footer-title-toggle" aria-expanded="false">
                      Page title
                      <span class="icon-down-arrow" aria-hidden="true"></span>
                    </button>
                  </h2>
                </div>

                <div class="toggle_content">
                  <p>{{ 'homepage.onboarding.no_content' | t }}</p>
                </div>
              {% endif %}
            </div>
          {% elsif block.type == 'guest_service_hours' %}
            {%- liquid
              assign guest_hours_any = false
              if block.settings.hours_mon != blank or block.settings.hours_tue != blank or block.settings.hours_wed != blank or block.settings.hours_thu != blank or block.settings.hours_fri != blank or block.settings.hours_sat != blank or block.settings.hours_sun != blank
                assign guest_hours_any = true
              endif
            -%}
            <div class="footer_content footer-text guest-service-hours">
              <div class="footer-heading">
                <h2 class="h6">
                  {% capture a11y_toggle_guest %}{{ 'general.accessibility.toggle_section' | t: title: block.settings.heading }}{% endcapture %}
                  {% capture fb_toggle_guest %}Toggle {{ block.settings.heading }} section{% endcapture %}
                  <button type="button" class="footer-title-toggle">
                    {{ block.settings.heading }}
                    <span class="icon-down-arrow" aria-hidden="true"></span>
                  </button>
                </h2>
              </div>

              <div class="toggle_content">
                {% if block.settings.phone != blank %}
                  <div class="guest-service-hours__row">
                    <span class="guest-service-hours__icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" focusable="false">
                        <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                      </svg>
                    </span>
                    <div class="guest-service-hours__body">
                      <a href="tel:+1{{ block.settings.phone | strip | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}" aria-label="Phone number: {{ block.settings.phone }}">{{ block.settings.phone }}</a>
                    </div>
                  </div>
                {% endif %}

                {% if block.settings.email != blank %}
                  <div class="guest-service-hours__row">
                    <span class="guest-service-hours__icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" focusable="false">
                        <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
                      </svg>
                    </span>
                    <div class="guest-service-hours__body">
                      <a href="mailto:{{ block.settings.email }}" aria-label="Email Address: {{ block.settings.email }}">{{ block.settings.email }}</a>
                    </div>
                  </div>
                {% endif %}

                {% if guest_hours_any %}
                  <div class="guest-service-hours__row">
                    <span class="guest-service-hours__icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" focusable="false">
                        <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>
                      </svg>
                    </span>
                    <div class="guest-service-hours__body">
                      <div class="guest-service-hours__grid">
                        {% if block.settings.hours_mon != blank %}<span class="guest-service-hours__day">Mon</span><span class="guest-service-hours__time">{{ block.settings.hours_mon }}</span>{% endif %}
                        {% if block.settings.hours_tue != blank %}<span class="guest-service-hours__day">Tue</span><span class="guest-service-hours__time">{{ block.settings.hours_tue }}</span>{% endif %}
                        {% if block.settings.hours_wed != blank %}<span class="guest-service-hours__day">Wed</span><span class="guest-service-hours__time">{{ block.settings.hours_wed }}</span>{% endif %}
                        {% if block.settings.hours_thu != blank %}<span class="guest-service-hours__day">Thu</span><span class="guest-service-hours__time">{{ block.settings.hours_thu }}</span>{% endif %}
                        {% if block.settings.hours_fri != blank %}<span class="guest-service-hours__day">Fri</span><span class="guest-service-hours__time">{{ block.settings.hours_fri }}</span>{% endif %}
                        {% if block.settings.hours_sat != blank %}<span class="guest-service-hours__day">Sat</span><span class="guest-service-hours__time">{{ block.settings.hours_sat }}</span>{% endif %}
                        {% if block.settings.hours_sun != blank %}<span class="guest-service-hours__day">Sun</span><span class="guest-service-hours__time">{{ block.settings.hours_sun }}</span>{% endif %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>
          {% elsif block.type == 'empty' %}
            <div class="empty-column"></div>
          {% endif %}

          {% if block.settings.social_icons_footer %}
            {%- assign social_icons = true -%}
            <div class="footer-social-icons {% if block.type == 'logo' %}text-align--{{ block.settings.text_align }}{% endif %}">
              {% render 'social-icons' %}
            </div>
          {% endif %}
        </div>

        {% if forloop.last and social_icons %}
          <div class="footer-social-icons--mobile sixteen columns">
            {% render 'social-icons' %}
          </div>
        {% endif %}
      {% endfor %}

      <div class="one-whole column footer_credits">
        <div class="footer-credits__top">
          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="footer__follow-on-shop">
              {{ shop | login_button: action: 'follow' }}
            </div>
          {%- endif -%}
          {% if locale_selector or currency_selector or settings.show_multiple_currencies == true %}
            <div class="localization-wrap">
              {%
                render 'localization-switcher',
                additional_classes: 'footer-menu__disclosure',
                id: 'footer__selector-form',
                currency_selector: currency_selector,
                locale_selector: locale_selector,
                show_currency: section.settings.show_currency_selector
              %}
            </div>
          {% endif %}
        </div>
        <div class="footer-credits__bottom">
          <p class="credits">
            &copy; {{ "now" | date: "%Y" }} {{ shop.name | link_to: routes.root_url }}. {{ section.settings.copyright_text }}

            {% if section.settings.display_designed_by %}
              {{ 'layout.general.designer_credits_html' | t }}
            {% endif %}

            {{ 'layout.general.powered_by_shopify_html' | t }}
            {% if shop.terms_of_service != blank %}
              | <a href="{{ shop.terms_of_service.url }}">Terms of Service</a>
            {% endif %}
          </p>
          {% if section.settings.display_payment_methods %}
            <div class="payment_methods">
              {% for type in shop.enabled_payment_types %}
                {{ type | payment_type_svg_tag: class:'payment-icon' }}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section--footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Sub footer"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text"
    },
    {
      "type": "checkbox",
      "id": "display_designed_by",
      "label": "Show theme designer credits",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "display_payment_methods",
      "label": "Show payment method icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Follow on Shop",
      "info": "Display follow button for your storefront on the Shop app. [Learn more](https://help.shopify.com/manual/online-store/themes/customizing-themes/follow-on-shop)"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "label": "Enable Follow on Shop",
      "default": true
    },
    {
      "type": "header",
      "content": "Language selector",
      "info": "To add a language, go to your [language settings.](/admin/settings/languages)"
    },
    {
      "type": "checkbox",
      "id": "show_locale_selector",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Country selector",
      "info": "To add a country, go to your [payment settings.](/admin/settings/payments)"
    },
    {
      "type": "checkbox",
      "id": "show_currency_selector",
      "label": "Show country selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "text_alignment",
          "id": "text_align",
          "label": "Text alignment"
        },
        {
          "type": "checkbox",
          "id": "social_icons_footer",
          "label": "Show social media footer icons",
          "default": false
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Subscribe today!"
        },
        {
          "type": "richtext",
          "id": "newsletter_text",
          "label": "Text"
        },
        {
          "type": "checkbox",
          "id": "show_firstname",
          "label": "Show first name"
        },
        {
          "type": "checkbox",
          "id": "show_lastname",
          "label": "Show last name"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social media icons"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "This menu won't show drop-down items"
        },
        {
          "type": "checkbox",
          "id": "social_icons_footer",
          "label": "Show social media footer icons",
          "default": false
        }
      ]
    },
    {
      "type": "page",
      "name": "Page",
      "limit": 1,
      "settings": [
        {
          "type": "page",
          "id": "page",
          "label": "Content page"
        },
        {
          "type": "checkbox",
          "id": "social_icons_footer",
          "label": "Show social media footer icons",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text",
          "default": "<p>Use this text to share information about your brand with your customers.</p>"
        },
        {
          "type": "checkbox",
          "id": "social_icons_footer",
          "label": "Show social media footer icons",
          "default": true
        }
      ]
    },
    {
      "type": "guest_service_hours",
      "name": "Guest service hours",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Guest Service Hours"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "1-800-253-3663"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "guesthelp@southernseason.com"
        },
        {
          "type": "header",
          "content": "Hours by day"
        },
        {
          "type": "text",
          "id": "hours_mon",
          "label": "Monday",
          "default": "9:00 am to 5:00 pm"
        },
        {
          "type": "text",
