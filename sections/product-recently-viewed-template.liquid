<script
  type="application/json"
  data-section-type="product-recently-viewed-template"
  data-section-id="{{ section.id }}"
>
</script>

{% assign collection_handles = product.collections | map: 'handle' %}

{% comment %} 
Fallback for missing alt text. 
Ensures screen readers announce the product title for the image link.
{% endcomment %}
{%- assign card_alt_text = product.title | escape -%}

<div class="js-recently-viewed-product product-{{ product.id }}" data-product-card>
  
  {% comment %} 
    Fix 1: Combined the image and product info into ONE link. 
    This removes duplicate tab stops for keyboard users.
  {% endcomment %}
  <a href="{{ product.url | within: collection }}" class="product-card__link" aria-label="{{ product.title | escape }}">
    
    <div class="product-wrap {% if settings.collection_secondary_image != blank and product.media[1] != blank %}has-secondary-media-swap{% endif %}">
      <div class="relative product_image">
        <div class="image__container">
          {% if settings.product_form_style == 'select' %}
            {%
              render 'quick-shop-gallery',
              product: product,
            %}
          {% else %}
            {% if settings.quick_shop_enabled and settings.quick_shop_style == 'inline' and product.selected_or_first_available_variant.image %}
              {%
                render 'image-element',
                image: product.selected_or_first_available_variant.image,
                alt: card_alt_text,
                object_fit: align_height,
                max_height: collection_height,
              %}
            {% else %}
              {%
                render 'image-element',
                image: product.featured_media.preview_image,
                alt: card_alt_text,
                object_fit: align_height,
                max_height: collection_height,
              %}
            {% endif %}
          {% endif %}
        </div>

        {% if settings.collection_secondary_image != blank and product.media[1] != blank %}
          {% if product.media[1].media_type == 'external_video' %}
            {% comment %} Fix 2: Hide visual background/hover videos from Screen Readers {% endcomment %}
            <div class="external-video__container lazyload lazypreload secondary-media-hidden video-on-hover" aria-hidden="true">
              <div class="youtube-wrapper" data-youtube-video>
                {{ product.media[1] | external_video_tag: aria_hidden: "true", tabindex: "-1" }}
              </div>
            </div>
          {% elsif product.media[1].media_type == 'video' %}
            <div class="video__container lazyload lazypreload secondary-media-hidden video-on-hover" data-html5-video aria-hidden="true">
              {{ product.media[1] | video_tag: controls: false, aria_hidden: "true", tabindex: "-1" }}
            </div>
          {% else %}
            {%
              render 'image-element',
              image: product.media[1].preview_image,
              alt: card_alt_text,
              additional_classes: 'secondary lazypreload secondary-media-hidden',
            %}
          {% endif %}
        {% endif %}
      </div>

      {%
        render 'product-details',
        product: product,
        collection: collection,
        collection_handles: collection_handles,
      %}
    </div>

    <div class="product-info__caption {% if settings.thumbnail_hover_enabled %}hidden{% endif %}">
      {%
        render 'product-info',
        product: product,
        collection_handles: collection_handles,
      %}
    </div>

  </a> {% comment %} End of main product card link {% endcomment %}

  {% unless settings.quick_shop_style == 'inline' and settings.quick_shop_enabled %}
    {%
      render 'collection-swatch',
      product: product,
    %}
  {% endunless %}

  {% if settings.quick_shop_style == 'inline' and settings.quick_shop_enabled %}
    {% unless collection_handles contains 'coming-soon' %}
      <div
        class="
          inline-quickshop
          js-product-section
          product-{{ product.id }}
        "
        aria-label="{{ 'products.product.add_to_cart' | t }}"
      >
        {%
          render 'product-form',
          product: product,
          show_payment_button: settings.show_dynamic_checkout_button,
          collection_handles: collection_handles,
        %}
      </div>
    {% endunless %}
  {% endif %}
</div>

<div class="js-recommended-products"></div>