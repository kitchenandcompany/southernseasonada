{%- assign heading_id = 'ss-categories-heading-' | append: section.id -%}

<section
  class="ss-section ss-categories"
  aria-labelledby="{{ heading_id }}"
  style="--ss-columns: {{ section.settings.columns }}; background-color: {{ section.settings.background_color }};"
>
  <div class="ss-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ss-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="ss-heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
    <div class="ss-rule" aria-hidden="true"></div>

    <ul class="ss-categories__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign image = block.settings.image
          assign title = block.settings.title
          assign show_block = true
          if image == blank and title == blank and request.design_mode == false
            assign show_block = false
          endif
        -%}
        {%- if show_block -%}
          <li class="ss-categories__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="ss-categories__link" href="{{ block.settings.link }}">
            {%- else -%}
              <div class="ss-categories__link">
            {%- endif -%}
              <div class="ss-categories__media">
                {%- if image != blank -%}
                  {%- capture image_style -%}object-position: {{ image.presentation.focal_point | default: 'center' }};{%- endcapture -%}
                  {{
                    image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(min-width: 990px) 33vw, 50vw',
                      alt: '',
                      class: 'ss-categories__img',
                      style: image_style
                  }}
                {%- else -%}
                  <span class="ss-categories__placeholder" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 17l-5-5-9 8"/></svg>
                    {%- if request.design_mode -%}<span>Add a category image</span>{%- endif -%}
                  </span>
                {%- endif -%}
              </div>
              <span class="ss-categories__title">
                {%- if title != blank -%}{{ title | escape }}{%- elsif request.design_mode -%}Category {{ forloop.index }}{%- endif -%}
              </span>
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Category grid",
  "class": "shopify-section--ss-category-grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Line above heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Category"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Categories per row (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "4:3 landscape works best"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Choose the collection this category opens"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["index", "page", "collection"]
  }
}
{% endschema %}
