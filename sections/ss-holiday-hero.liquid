{%- liquid
  assign slide_count = section.blocks.size
  assign autoplay = false
  if section.settings.autoplay and slide_count > 1
    assign autoplay = true
  endif
-%}

{%- if slide_count > 0 -%}
<section
  class="ss-hero-slider"
  id="ss-hero-{{ section.id }}"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.carousel_label | default: 'Featured' | escape }}"
  data-ss-hero-slider
  data-autoplay="{{ autoplay }}"
  data-speed="{{ section.settings.speed | times: 1000 }}"
>
  <div class="ss-hero-slider__slides" {% if autoplay %}aria-live="off"{% else %}aria-live="polite"{% endif %}>
    {%- for block in section.blocks -%}
      {%- liquid
        assign image = block.settings.image
        assign heading_tag = 'h2'
        if forloop.first
          assign heading_tag = 'h1'
        endif
        assign show_button1 = false
        assign show_button2 = false
        if block.settings.button1_label != blank and block.settings.button1_link != blank
          assign show_button1 = true
        endif
        if block.settings.button2_label != blank and block.settings.button2_link != blank
          assign show_button2 = true
        endif
      -%}
      {%- capture image_style -%}object-position: {{ image.presentation.focal_point | default: 'center' }};{%- endcapture -%}

      <div
        class="ss-hero ss-hero--image-{{ block.settings.image_position | default: 'right' }} ss-hero-slider__slide{% if forloop.first %} is-active{% endif %}"
        role="group"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} of {{ slide_count }}"
        data-ss-hero-slide
        data-block-id="{{ block.id }}"
        style="--ss-hero-bg: {{ block.settings.background_color }}; --ss-hero-text: {{ block.settings.text_color }}; --ss-hero-btn-bg: {{ block.settings.button_color | default: '#0E553C' }}; --ss-hero-btn-text: {{ block.settings.button_text_color | default: '#FFFFFF' }}; --ss-hero-heading-size: {{ block.settings.heading_size | default: 76 }}px; --ss-hero-sub-size: {{ block.settings.subheading_size | default: 22 }}px;"
        {% unless forloop.first %}hidden{% endunless %}
        {{ block.shopify_attributes }}
      >
        <div class="ss-hero__text">
          {%- if block.settings.badge != blank -%}
            <p class="ss-hero__badge">{{ block.settings.badge | escape }}</p>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <{{ heading_tag }} class="ss-hero__heading">{{ block.settings.heading | escape }}</{{ heading_tag }}>
          {%- endif -%}

          {%- if block.settings.subheading != blank -%}
            <p class="ss-hero__sub">{{ block.settings.subheading | escape | newline_to_br }}</p>
          {%- endif -%}

          {%- if show_button1 or show_button2 -%}
            <div class="ss-hero__buttons">
              {%- if show_button1 -%}
                <a class="ss-btn ss-btn--primary" href="{{ block.settings.button1_link }}">{{ block.settings.button1_label | escape }}</a>
              {%- endif -%}
              {%- if show_button2 -%}
                <a class="ss-btn ss-btn--outline" href="{{ block.settings.button2_link }}">{{ block.settings.button2_label | escape }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        <div class="ss-hero__media">
          {%- if image != blank -%}
            {%- if forloop.first -%}
              {{
                image
                | image_url: width: 1800
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '600, 900, 1200, 1500, 1800',
                  sizes: '(min-width: 990px) 60vw, 100vw',
                  alt: image.alt,
                  class: 'ss-hero__img',
                  style: image_style
              }}
            {%- else -%}
              {{
                image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '600, 900, 1200, 1500, 1800',
                  sizes: '(min-width: 990px) 60vw, 100vw',
                  alt: image.alt,
                  class: 'ss-hero__img',
                  style: image_style
              }}
            {%- endif -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'ss-hero__img ss-placeholder' }}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if slide_count > 1 -%}
    <div class="ss-hero-slider__controls">
      <button type="button" class="ss-hero-slider__arrow" data-ss-hero-prev aria-label="Previous slide">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg>
      </button>
      <div class="ss-hero-slider__dots">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="ss-hero-slider__dot"
            data-ss-hero-dot="{{ forloop.index0 }}"
            aria-label="Show slide {{ forloop.index }} of {{ slide_count }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          ></button>
        {%- endfor -%}
      </div>
      <button type="button" class="ss-hero-slider__arrow" data-ss-hero-next aria-label="Next slide">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg>
      </button>
      {%- if autoplay -%}
        <button type="button" class="ss-hero-slider__pause" data-ss-hero-pause aria-label="Pause slideshow" aria-pressed="false">
          <svg class="ss-hero-slider__pause-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor"/></svg>
          <svg class="ss-hero-slider__play-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{%- if slide_count > 1 -%}
<script>
  (function () {
    var root = document.getElementById('ss-hero-{{ section.id }}');
    if (!root || root.dataset.ssHeroReady) return;
    root.dataset.ssHeroReady = 'true';

    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-ss-hero-slide]'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-ss-hero-dot]'));
    var pauseButton = root.querySelector('[data-ss-hero-pause]');
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var autoplay = root.dataset.autoplay === 'true' && !reduceMotion;
    var speed = parseInt(root.dataset.speed, 10) || 6000;
    var current = 0;
    var timer = null;
    var userPaused = false;
    var hoverPaused = false;

    function show(index) {
      current = (index + slides.length) % slides.length;
      slides.forEach(function (slide, i) {
        var active = i === current;
        slide.hidden = !active;
        slide.classList.toggle('is-active', active);
      });
      dots.forEach(function (dot, i) {
        if (i === current) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function start() {
      stop();
      if (autoplay && !userPaused && !hoverPaused) {
        timer = setInterval(function () { show(current + 1); }, speed);
      }
    }

    root.querySelector('[data-ss-hero-prev]').addEventListener('click', function () { show(current - 1); start(); });
    root.querySelector('[data-ss-hero-next]').addEventListener('click', function () { show(current + 1); start(); });
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () { show(parseInt(dot.dataset.ssHeroDot, 10)); start(); });
    });

    if (pauseButton) {
      if (!autoplay) {
        pauseButton.hidden = true;
      }
      pauseButton.addEventListener('click', function () {
        userPaused = !userPaused;
        pauseButton.setAttribute('aria-pressed', userPaused ? 'true' : 'false');
        pauseButton.setAttribute('aria-label', userPaused ? 'Play slideshow' : 'Pause slideshow');
        root.classList.toggle('is-paused', userPaused);
        start();
      });
    }

    root.addEventListener('mouseenter', function () { hoverPaused = true; stop(); });
    root.addEventListener('mouseleave', function () { hoverPaused = false; start(); });
    root.addEventListener('focusin', function () { hoverPaused = true; stop(); });
    root.addEventListener('focusout', function (event) {
      if (!root.contains(event.relatedTarget)) {
        hoverPaused = false;
        start();
      }
    });

    document.addEventListener('shopify:block:select', function (event) {
      var index = slides.findIndex(function (slide) { return slide.dataset.blockId === event.detail.blockId; });
      if (index > -1) {
        show(index);
        stop();
      }
    });

    start();
  })();
</script>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Holiday hero",
  "class": "shopify-section--ss-holiday-hero",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "info": "Includes a pause button. Rotation stops while a visitor hovers or uses the keyboard, and for visitors who prefer reduced motion.",
      "default": false
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds per slide",
      "min": 5,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 7
    },
    {
      "type": "text",
      "id": "carousel_label",
      "label": "Slideshow name for screen readers",
      "default": "Featured holiday gifts"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "2026 Catalog"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Holiday Gifts"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Local NC Goods & Gift Baskets\nSince 1975"
        },
        {
          "type": "range",
          "id": "heading_size",
          "label": "Heading size",
          "info": "Largest size on desktop. Shrinks automatically on smaller screens.",
          "min": 32,
          "max": 110,
          "step": 2,
          "unit": "px",
          "default": 76
        },
        {
          "type": "range",
          "id": "subheading_size",
          "label": "Subheading size",
          "min": 16,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 22
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Landscape photo, at least 1800px wide. Set the alt text on the image in Files."
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image side",
          "default": "right",
          "options": [
            {
              "value": "right",
              "label": "Right"
            },
            {
              "value": "left",
              "label": "Left"
            }
          ]
        },
        {
          "type": "header",
          "content": "Buttons"
        },
        {
          "type": "text",
          "id": "button1_label",
          "label": "Primary button label",
          "default": "Shop Holiday Gifts"
        },
        {
          "type": "url",
          "id": "button1_link",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "button2_label",
          "label": "Secondary button label",
          "default": "View the Catalog"
        },
        {
          "type": "url",
          "id": "button2_link",
          "label": "Secondary button link"
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Text panel background",
          "default": "#F6EEDE"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "info": "Also used for the secondary (outline) button",
          "default": "#30302F"
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "Primary button color",
          "info": "Pick a color that stands out from the panel background, such as Southern Season red on a green panel",
          "default": "#0E553C"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Primary button text",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Holiday hero",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["index", "page", "collection"]
  }
}
{% endschema %}
