<script
  type="application/json"
  data-section-type="featured-promotions"
  data-section-id="{{ section.id }}"
>
</script>

{% liquid
  assign id = section.id
  assign blocks = section.blocks
%}

{% style %}
  {% render 'section-space' %}

  {% if section.settings.background_color != blank and section.settings.background_color != 'rgba(0,0,0,0)' %}
    #shopify-section-{{ id }} {
      background-color: {{ section.settings.background_color }};
    }
  {% endif %}

  {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: id,
  %}
{% endstyle %}

{% if blocks.size > 0 %}
  <section
    class="
      section
      {% if section.settings.wide_display == true %}
        is-width-wide
        has-no-side-gutter
      {% endif %}
      {{ section.settings.css_class }}
    "
    {% if section.settings.heading != blank %}aria-labelledby="FeaturedPromotionsHeading-{{ id }}"{% endif %}
    data-fp-shade
    style="--fp-shade-desktop: {{ section.settings.overlay_desktop | default: 50 | divided_by: 100.0 }}; --fp-shade-mobile: {{ section.settings.overlay_mobile | default: 50 | divided_by: 100.0 }};"
  >
    {% if section.settings.heading != blank %}
      <div class="container">
        <div class="one-whole column center featured-promotions__header">
          {% if section.settings.eyebrow != blank %}
            <p class="ss-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          <h2 class="ss-heading" id="FeaturedPromotionsHeading-{{ id }}">{{ section.settings.heading | escape }}</h2>
          <div class="ss-rule" aria-hidden="true"></div>
        </div>
      </div>
    {% endif %}
    <div
      class="
        container
        js-featured-promotions
        featured-promotions
        full-width--{{ section.settings.wide_display }}
      "
      data-promo-animation="{{ section.settings.featured_links_animation }}"
    >
      {% for block in blocks %}
        {%- liquid
          assign title_tag = 'h2'
          if section.settings.heading != blank
            assign title_tag = 'h3'
          endif
        -%}
        {% comment %} Content settings {% endcomment %}
        {%- assign image = block.settings.image -%}
        {%- assign mobile_image = block.settings.mobile_image -%}
        {% comment %} End content settings {% endcomment %}

        <figure class="feature-section section-{{ forloop.index }} promo-{{ forloop.index }} {% render 'column-width', value: section.settings.featured_promos_per_row %} column medium-down--one-whole title-overlay-{{ section.settings.promo_text_on_image_enabled }} {% if section.settings.featured_links_animation != blank %}promo-animation--true{% endif %}" {{ block.shopify_attributes }}>
          <div class="feature-inner feature-style--{{ section.settings.feature_style }}">
            {% if mobile_image %}
              <div class="is-hidden-mobile-only">
            {% endif %}
            {% if image %}
              {%
                render 'image-element',
                image: image,
                alt: image.alt,
                stretch_width: true,
                focal_point: image.presentation.focal_point,
              %}
            {% else %}
              {% capture i %}{% cycle "1", "2", "3", "4", "5", "6" %}{% endcapture %}
              {{ 'collection-' | append: i | placeholder_svg_tag: 'placeholder-svg placeholder-svg--promotions' }}
            {% endif %}
            {% if mobile_image %}
              </div>
              <div class="is-hidden-desktop-only">
                {%
                  render 'image-element',
                  image: mobile_image,
                  alt: mobile_image.alt,
                  stretch_width: true,
                  focal_point: mobile_image.presentation.focal_point,
                %}
              </div>
            {% endif %}

            {% if block.settings.text != blank or block.settings.button_label != blank or block.settings.title != blank and section.settings.promo_text_on_image_enabled != blank %}
              <figcaption class="feature-overlay" {% if block.settings.link == blank or block.settings.title == blank %}tabindex="0"{% endif %}>
<a 
  {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} 
  class="link-promo" 
  role="presentation" tabindex="-1" aria-hidden="true"
></a>
                  <div class="feature-wrap">
                    {% if block.settings.title != blank %}
                      <{{ title_tag }} class="title">
                        {%- if block.settings.link != blank -%}
                          <a class="feature-title-link" href="{{ block.settings.link }}">{{ block.settings.title }}</a>
                        {%- else -%}
                          {{ block.settings.title }}
                        {%- endif -%}
                      </{{ title_tag }}>
                    {% endif %}

                    <div class="feature-details">
                      {% if block.settings.text != blank %}
                        <div class="description">
                          {{ block.settings.text }}
                        </div>
                      {% endif %}

                      {% if block.settings.button_label != blank %}
                        <a {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} class="global-button feature-details__button" aria-label="{{ block.settings.button_label }} {{ block.settings.title }}">
                          {{ block.settings.button_label }}
                        </a>
                      {% endif %}
                    </div>
                  </div>
              </figcaption>
            {% elsif block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="link-promo" tabindex="-1" aria-hidden="true"></a>
            {% endif %}
          </div>

          {% if section.settings.promo_text_on_image_enabled == blank %}
            {% if block.settings.title != blank %}
              <a {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}>
                <{{ title_tag }} class="title title-below">{{ block.settings.title }}</{{ title_tag }}>
              </a>
            {% endif %}
          {% endif %}
        </figure>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Featured promotions",
  "class": "shopify-section--featured-promotions",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Line above heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Clear to remove the background. Catalog-friendly options: warm ivory #FBF7EF, cream #F6EEDE."
    },
    {
      "type": "checkbox",
      "id": "wide_display",
      "label": "Wide display",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "promo_text_on_image_enabled",
      "label": "Show title on image",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_desktop",
      "label": "Image shade on desktop",
      "info": "How dark the shade behind titles is. Below about 40%, white titles can be hard to read on light photos.",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "overlay_mobile",
      "label": "Image shade on mobile",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "featured_promos_per_row",
      "label": "Promotions per row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "featured_links_animation",
      "label": "Promotions animation",
      "default": "fadeInDown",
      "options": [
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInUp",
          "label": "Fade up"
        },
        {
          "value": "fadeInDown",
          "label": "Fade down"
        },
        {
          "value": "",
          "label": "None"
        }
      ]
    },
    {
      "type": "select",
      "id": "feature_style",
      "label": "Promotions style",
      "default": "square",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "paragraph",
      "content": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Promotion",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "840 x 840px recommended"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image",
          "info": "900 x 1800px recommended"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Header",
          "default": "Feature"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Promotion description details.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured promotions",
      "category": "Image",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [ "*" ]
  }
}

{% endschema %}