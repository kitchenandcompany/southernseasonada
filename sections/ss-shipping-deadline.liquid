{%- assign heading_id = 'ss-ship-heading-' | append: section.id -%}

<section
  class="ss-ship"
  aria-labelledby="{{ heading_id }}"
  style="--ss-ship-bg: {{ section.settings.background_color }}; --ss-ship-text: {{ section.settings.text_color }}; --ss-ship-accent: {{ section.settings.accent_color }};"
>
  <div class="ss-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ss-ship__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h2 class="ss-ship__heading" id="{{ heading_id }}">
      {{- section.settings.heading | escape -}}
      {%- if section.settings.heading_date != blank %} <span>{{ section.settings.heading_date | escape }}</span>{%- endif -%}
    </h2>

    {%- if section.settings.subheading != blank -%}
      <p class="ss-ship__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="ss-ship__timeline" role="list">
        {%- for block in section.blocks -%}
          <li class="ss-ship__step" {{ block.shopify_attributes }}>
            <span class="ss-ship__date">{{ block.settings.date | escape }}</span>
            <span class="ss-ship__dot" aria-hidden="true"></span>
            <span class="ss-ship__label">{{ block.settings.label | escape }}</span>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.pill_text != blank -%}
      {%- if section.settings.pill_link != blank -%}
        <a class="ss-ship__pill" href="{{ section.settings.pill_link }}">{{ section.settings.pill_text | escape }}</a>
      {%- else -%}
        <p class="ss-ship__pill">{{ section.settings.pill_text | escape }}</p>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="ss-ship__footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shipping deadline",
  "class": "shopify-section--ss-shipping-deadline",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Line above heading",
      "default": "Holiday Shipping Deadline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Order by"
    },
    {
      "type": "text",
      "id": "heading_date",
      "label": "Heading date (shown in the accent color)",
      "default": "Dec 16"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "for Christmas delivery with standard shipping."
    },
    {
      "type": "text",
      "id": "pill_text",
      "label": "Highlight button text",
      "default": "Over 20 Gifts Ship Free"
    },
    {
      "type": "url",
      "id": "pill_link",
      "label": "Highlight button link"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Free shipping applies to standard shipping only. Excludes PO Box, APO/FPO, AK & HI addresses."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0E553C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F6EEDE"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#DDB868"
    }
  ],
  "blocks": [
    {
      "type": "deadline",
      "name": "Ship-by date",
      "settings": [
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "Dec 16"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Shipping method",
          "default": "Standard Shipping & UPS Ground"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Shipping deadline",
      "blocks": [
        { "type": "deadline", "settings": { "date": "Dec 16", "label": "Standard Shipping & UPS Ground" } },
        { "type": "deadline", "settings": { "date": "Dec 22", "label": "UPS 2-Day Air" } },
        { "type": "deadline", "settings": { "date": "Dec 23", "label": "UPS Next Day Air" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["index", "page", "collection", "product", "cart"]
  }
}
{% endschema %}
