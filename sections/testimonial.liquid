<script
  type="application/json"
  data-section-type="testimonial"
  data-section-id="{{ section.id }}"
>
</script>

{% assign mobile_text_alpha = section.settings.mobile_text_color | default: 'rgba(0,0,0,0)' | color_extract: 'alpha' %}

{% style %}
  {% render 'section-space' %}

  {% if section.settings.mobile_text_below_image and mobile_text_alpha != 0 %}
    @media only screen and (max-width: 480px) {
      #shopify-section-{{ section.id }} .pretext,
      #shopify-section-{{ section.id }} .headline,
      #shopify-section-{{ section.id }} .subtitle {
        color: {{ section.settings.mobile_text_color }};
      }

      #shopify-section-{{ section.id }} .feature-divider {
        border-color: {{ section.settings.mobile_text_color }};
      }
    }
  {% endif %}

  {% render 'css-loop', css: section.settings.custom_css, id: section.id %}

  {% comment %}
    Accessibility CSS: Ensures clean outlines on focused slide links.
  {% endcomment %}
  .testimonial-block a:focus {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  {% comment %}
    Autoplay play/pause toggle: sits beside the page dots, at the bottom
    edge of the slideshow (which is the Flickity positioning context).
  {% endcomment %}
  #shopify-section-{{ section.id }} .testimonial-autoplay-toggle {
    position: absolute;
    bottom: 20px;
    right: 12px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: 1px solid #333;
    border-radius: 50%;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
    opacity: 1;
    visibility: visible;
    cursor: pointer;
    padding: 0;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .testimonial-autoplay-toggle:hover,
  #shopify-section-{{ section.id }} .testimonial-autoplay-toggle:focus {
    background: #111;
    border-color: #111;
  }

  #shopify-section-{{ section.id }} .testimonial-autoplay-toggle:hover svg,
  #shopify-section-{{ section.id }} .testimonial-autoplay-toggle:focus svg {
    fill: #fff;
  }

  #shopify-section-{{ section.id }} .testimonial-autoplay-toggle:focus {
    outline: 2px solid #333;
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .testimonial-autoplay-toggle svg {
    width: 14px;
    height: 14px;
    fill: #333;
  }

  #shopify-section-{{ section.id }} .testimonial-autoplay-toggle .icon-pause {
    display: none;
  }

  #shopify-section-{{ section.id }} .testimonial-autoplay-toggle[data-playing="true"] .icon-play {
    display: none;
  }

  #shopify-section-{{ section.id }} .testimonial-autoplay-toggle[data-playing="true"] .icon-pause {
    display: block;
  }
{% endstyle %}

{% if section.blocks.size > 0 %}
  {% capture a11y_testimonial_section %}{{ 'general.accessibility.testimonial_section' | t }}{% endcapture %}
  <section
    class="
      section
      {% if section.settings.wide_display == true %}
        is-width-wide
        has-no-side-gutter
      {% endif %}
      {{ section.settings.css_class }}
    "
    aria-label="{% render 'a11y-missing-fallback', text: a11y_testimonial_section, fallback: 'Customer testimonials' %}"
  >
    <div class="container">
      <div class="one-whole column">
        <div
          class="
            testimonial-slideshow
            js-testimonial
            {% if section.settings.testimonial_text_animation != '' %}
              text-animation--true
            {% endif %}
            transparentBackground--{{ settings.slideshow_button_style }}
            full-width--{{ section.settings.wide_display }}
          "
          id="testimonial-{{ section.id }}"
          data-slider-id="testimonial-{{ section.id }}"
          data-slideshow-speed="{{ section.settings.testimonial_speed }}"
          data-slideshow-text-animation="{{ section.settings.testimonial_text_animation }}"
          data-adaptive-height="{{ section.settings.activate_adaptiveHeight }}"
          role="region"
          aria-roledescription="carousel"
        >
          {% for block in section.blocks %}
            <div
              class="
                testimonial-block
                gallery-cell
                slide-{{ forloop.index }}
                caption-background-{{ block.settings.caption_content_background }}
                caption--below-{{ section.settings.mobile_text_below_image }}
                {% if block.settings.image == blank %}
                  set-static
                  testimonial-block--no-image
                {% endif %}
              "
              {{ block.shopify_attributes }}
              data-block-id="{{ block.id }}"
              aria-roledescription="slide">
              {% comment %} 
                FIX: Handled proper dynamic fallback alt text for store names instead of leaving them blank.
              {% endcomment %}
              {% assign image_alt = block.settings.image.alt | default: block.settings.store_name | default: "Customer review illustration" %}
              
              {% if block.settings.image %}
                {% if block.settings.mobile_image %}
                  <div class="is-hidden-mobile-only" aria-hidden="true">
                {% else %}
                  <div aria-hidden="true">
                {% endif %}

                {% render 'image-element', image: block.settings.image, alt: image_alt, stretch_width: true, focal_point: block.settings.image.presentation.focal_point %}

                {% if block.settings.caption_content_background == 'darken_bg' %}
                  <div class="darken-bg"></div>
                {% endif %}

                </div>

                {% if block.settings.mobile_image %}
                  {% assign mobile_image_alt = block.settings.mobile_image.alt | default: block.settings.store_name | default: "Customer review illustration" %}
                  
                  <div class="is-hidden-desktop-only" aria-hidden="true">
                    {% render 'image-element', image: block.settings.mobile_image, alt: mobile_image_alt, stretch_width: true, focal_point: block.settings.mobile_image.presentation.focal_point %}

                    {% if block.settings.caption_content_background == 'darken_bg' %}
                      <div class="darken-bg"></div>
                    {% endif %}
                  </div>
                {% endif %}
              {% endif %}

              <div
                class="
                  caption
                  position-{{ block.settings.text_position }}
                  js-caption
                "
              >
                <div
                  class="
                    caption-content
                    testimonial-text
                    align-{{ block.settings.text_align }}
                  "
                >
                  {% if block.settings.title != blank %}
                    <p class="headline testimonial-block__kicker">{{ block.settings.title }}</p>
                    <div class="feature-divider"></div>
                  {% endif %}

                  <div class="subtitle">
                    <blockquote style="margin: 0; padding: 0; border: none;">
                      {{ block.settings.testimonial }}
                    </blockquote>

                    <p>
                      {% if block.settings.name != blank %}
                        <cite>{{ block.settings.name }}</cite><br>
                      {% endif %}

                      {% if block.settings.store_name != blank %}
                        {% if block.settings.link != blank %}
                          {% comment %} FIX: Links pulled out of reading elements so focus trees don't get trapped. {% endcomment %}
                          <a href="{{ block.settings.link }}" aria-label="Visit the {{ block.settings.store_name }} website"><strong>{{ block.settings.store_name }}</strong></a>
                        {% else %}
                          <strong>{{ block.settings.store_name }}</strong>
                        {% endif %}
                      {% endif %}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}

          {% if section.blocks.size > 1 and section.settings.testimonial_speed > 0 %}
            <button
              type="button"
              class="testimonial-autoplay-toggle"
              data-playing="true"
              aria-pressed="false"
              aria-label="Pause testimonial slideshow"
            >
              <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="5" height="16"></rect><rect x="14" y="4" width="5" height="16"></rect></svg>
              <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4l14 8-14 8z"></path></svg>
            </button>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Testimonials",
  "class": "shopify-section--testimonials",
  "settings": [
    {
      "type": "checkbox",
      "id": "wide_display",
      "label": "Wide display",
      "default": true
    },
    {
      "type": "select",
      "id": "testimonial_text_animation",
      "label": "Text animation",
      "default": "fadeInDown",
      "options": [
        {
          "value": "",
          "label": "None"
        },
        {
          "value": "fadeIn",
          "label": "Fade in"
        },
        {
          "value": "fadeInUp",
          "label": "Fade up"
        },
        {
          "value": "fadeInDown",
          "label": "Fade down"
        }
      ]
    },
    {
      "type": "range",
      "id": "testimonial_speed",
      "label": "Change testimonials every",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 6,
      "unit": "sec"
    },
    {
      "type": "checkbox",
      "id": "activate_adaptiveHeight",
      "label": "Enable adaptive height",
      "info": "Slideshow will adjust based on height of individual slides",
      "default": false
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "mobile_text_below_image",
      "label": "Show text below image",
      "default": true
    },
    {
      "type": "color",
      "id": "mobile_text_color",
      "label": "Text below image",
      "info": "Set this to “None” to use the “Regular text” color."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Customer Testimonial"
        },
        {
          "type": "richtext",
          "id": "testimonial",
          "label": "Testimonial",
          "default": "<p>Include some of your favorite customer quotes and feedback here as social proof, to build credibility and trust for your services and products.</p>"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        },
        {
          "type": "text",
          "id": "store_name",
          "label": "Store name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Store link"
        },
        {
          "type": "header",
          "content": "Content layout"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "text_alignment",
          "id": "text_align",
          "label": "Text alignment",
          "default": "center"
        },
        {
          "type": "header",
          "content": "Background image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "1600 x 1000px recommended"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image",
          "info": "Display a different image on mobile screens. This only appears when the desktop image is set."
        },
        {
          "type": "header",
          "content": "Text contrast",
          "info": "Improve legibility by applying a contrast technique to your banner’s text."
        },
        {
          "type": "select",
          "id": "caption_content_background",
          "label": "Contrast technique",
          "default": "original",
          "options": [
            {
              "value": "original",
              "label": "None"
            },
            {
              "value": "darken_bg",
              "label": "Darken banner image"
            },
            {
              "value": "text_box",
              "label": "Solid box"
            },
            {
              "value": "translucent_text_box",
              "label": "Translucent box"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "category": "Text",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [ "*" ]
  }
}
{% endschema %}