<script
  type="application/json"
  data-section-type="featured-collection"
  data-section-id="{{ section.id }}"
>
</script>

{% liquid
  assign collection = collections[section.settings.collection]
  assign products_per_row = section.settings.products_per
  assign even_num_slides = products_per_row | modulo: 2

  if collection == blank
    assign section_onboarding = true
    # Assign product length to be selected limit for onboarding
    assign products_length = section.settings.products_limit | plus: 0
  else
    assign section_onboarding = false
  endif
%}

{% style %}
  {% render 'section-space' %}

  {%
    render 'css-loop',
    css: section.settings.custom_css,
    id: section.id,
  %}

  {% comment %} 
    Accessibility CSS: Ensures focus state visibility for tab-navigation users.
  {% endcomment %}
  .featured-collection__view-all-button:focus,
  .featured-collection__title-link:focus {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }
{% endstyle %}

<div class="{{ section.settings.css_class }}">
  <section
    class="section">
    <div class="container">
      <div class="one-whole column center homepage_content">
        {% if section.settings.title != blank %}
          {% comment %} 
            FIX: Flipped the nesting. Screen readers prefer the Heading to be the parent of the Link.
          {% endcomment %}
          <h2 class="title">
            <a 
              href="{{ collection.url | default: '#' }}" 
              class="featured-collection__title-link"
              aria-label="View all products in {{ section.settings.title | escape }}"
            >
              {{ section.settings.title | escape }}
            </a>
          </h2>
          <div class="feature-divider"></div>
        {% endif %}

        {% if section.settings.collection_description and collection.description != blank %}
          <div class="featured-collection__description rte">
            {{ collection.description }}
          </div>
        {% endif %}
      </div>
    </div>
  </section>

  {% if section.settings.collection_style == 'slider' %}
    <div
      class="
        js-product-slider
        homepage-product-slider
        full-width--true
        featured-collection__products
        {% if even_num_slides == 0 %}
          even-num-slides
        {% endif %}
      "
      role="region"
      aria-label="{{ section.settings.title | escape }} Products"
      aria-roledescription="carousel">
      
      {% if section_onboarding == false %}
        {% if collection.products.size > 0 %}
          {%
            render 'product-slider',
            limit: section.settings.products_limit,
            products: collection.products,
            collection: collection,
            per_slide: products_per_row,
            featured_collection: collection,
          %}
        {% endif %}
      {% else %}
        
        <div class="slider-gallery products-slider products-length-{{ products_length }}"
             data-products-per-slide="{{ products_per_row }}"
             data-products-limit="{{ section.settings.products_limit }}"
             data-products-available="{{ products_length }}">
          {% for i in (1..section.settings.products_limit) %}
            {%- assign per_slide_num = products_per_row -%}

            {% comment %} FIX: Added proper slide ARIA roles to the onboarding cells {% endcomment %}
            <div 
              class="gallery-cell thumbnail {% if products_length > per_slide_num %}visible-{{ products_per_row }}{% else %}visible-{{ products_length }}{% endif %}"
              role="group"
              aria-roledescription="slide"
              aria-label="Example Product {{ forloop.index }} of {{ section.settings.products_limit }}"
            >
              <div class="product-wrap">
                <div class="relative product_image">
                  {% comment %} 
                    FIX: Kept the link hidden from focus, and replaced the invalid <object> tag with a <div>
                  {% endcomment %}
                  <a href="#" tabindex="-1" aria-hidden="true">
                    <div class="placeholder-image">
                      {% capture num %}{% cycle "1", "2", "3", "4", "5", "6" %}{% endcapture %}
                      {{ 'product-' | append: num | placeholder_svg_tag: 'placeholder-svg placeholder-svg--product' }}
                    </div>
                  </a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% else %}
    {% if section_onboarding == false %}
      <section class="section" aria-label="Products grid">
        <div class="container">
          <div class="one-whole column">
            {% render 'product-loop', limit: section.settings.products_limit, plus: 1, products: collection.products, collection: collection, skip_product: product, products_per_row: products_per_row %}
          </div>
        </div>
      </section>
    {% else %}
      
      <section class="section" aria-label="Example products grid">
        <div class="product-list product-list--collection">
          <div class="container">
            {% for i in (1..section.settings.products_limit) %}
              {%- assign collection_group_thumb = collection_group | append : 'thumb' -%}
              {%- assign collection_group_mobile = collection_group | append : 'mobile' -%}

              <div class="{% render 'column-width', value: products_per_row %} column {% if settings.collection_secondary_image != blank and product.media[1] != blank %}has-secondary-media-swap{% endif %} thumbnail {% if settings.mobile_products_per_row == '1' %}medium-down--one-half small-down--one-whole{% else %}medium-down--one-half small-down--one-half{% endif %}">
                <div class="product-wrap {% if settings.collection_secondary_image != blank and product.media[1] != blank %}has-secondary-media-swap{% endif %}">
                  <div class="relative product_image">
                    {% comment %} FIX: Replaced invalid <object> tag with a <div> {% endcomment %}
                    <a href="#" tabindex="-1" aria-hidden="true">
                      <div class="placeholder-image">
                        {% capture num %}{% cycle "1", "2", "3", "4", "5", "6" %}{% endcapture %}
                        {{ 'product-' | append: num | placeholder_svg_tag: 'placeholder-svg placeholder-svg--product' }}
                      </div>
                    </a>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}
  {% endif %}

  {% if section.settings.collection_view_all %}
    <div class="section">
      <div class="container">
        <div class="one-whole column center">
          <a
            class="
              featured-collection__view-all-button
              global-button
              global-button--text
            "
            href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}"
            aria-label="View all of {% if collection != blank %}{{ collection.title | escape }}{% else %}this collection{% endif %}"
          >
            {{- 'collections.general.view_all' | t -}}
          </a>
        </div>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Featured collection",
  "class": "shopify-section--featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "checkbox",
      "id": "collection_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "collection_view_all",
      "label": "Enable 'View all' button",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "radio",
      "id": "collection_style",
      "label": "Collection layout",
      "default": "grid",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ]
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_per",
      "label": "Products per row",
      "min": 2,
      "max": 7,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Limit products",
      "min": 2,
      "max": 50,
      "step": 1,
      "default": 9
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "Featured collection",
      "category": "Collection"
    }
  ],
  "enabled_on": {
    "templates": [
      "404",
      "article",
      "blog",
      "cart",
      "collection",
      "list-collections",
      "index",
      "page",
      "product",
      "search"
    ]
  }
}
{% endschema %}{%- comment -%}

