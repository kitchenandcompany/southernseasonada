<div class="row grid_wrapper">
    <div id="page_content" class="span-8 push-2 auto sm-span-12 auto ada-form-is">
            <div class="rte">
                 <h1 class="waformheading">{{ page.title }}</h1>
          <p>Please fill out the following form to report a web accessibility related issue. We will do our best to assist in fixing the issue or offering an alternative. Thank you.</p>
     
    <section class="waform">    
        <div
          class="
            contact__form-form
          "
        >
          {%
            form 'contact',
            class: 'is-flex is-flex-wrap',
            id: 'contactForm'
          %}
          <div class="contact__form-name">
            {% assign name_attr = 'contact.form.name' | handle %}
    
            <label for="contactFormName">
              Name (Optional)
            </label>
    
            <input
              id="contactFormName"
              type="text"
              name="contact[{{ name_attr }}]"
              placeholder="Name"
              autocapitalize="words"
              value="{% if form[name_attr] %}{{ form[name_attr] }}{% elsif customer %}{{ customer.name }}{% endif %}"        >
          </div>
    
          <div class="contact__form-email">
            <label for="contactFormEmail">
              Email Address <span class="red">*</span>
            </label>
    
            <input
              id="contactFormEmail"
              type="email"
              name="contact[email]"
              placeholder="Email Address"
              autocapitalize="off"
              autocorrect="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              required="required"
              aria-required="true"
            >
          </div>
    
            <div class="contact__form-phone">
      <label for="contactFormPhone">
        Phone Number (Optional)
      </label>
    
      <input
        id="contactFormPhone"
        type="tel"
        name="contact[phone]"
        placeholder="Phone Number"
        autocapitalize="off"
        autocorrect="off"
        value="{% if form.phone %}{{ form.phone }}{% endif %}"
      >
    </div>
    
    
          <div class="contact__form-message">
            <label for="contactFormMessage">
              Describe The Nature of The Problem <span class="red">*</span>
            </label>
            <p id="details-issue">Please provide detailed information about the accessibility issue(s) you encountered, including the specific link(s) where the problem(s) occurred, the assistive technology you used, and why the issue(s) posed a challenge for you.</p>
    
            <textarea
              id="contactFormMessage"
              rows="5"
              name="contact[body]"
              placeholder="Describe The Nature of The Problem "
              required="required"
              aria-required="true"
            ></textarea>
    
            <input
              class="
                submit
                action_button
              "
              type="submit"
              value="Submit"
              aria-label="Submit, the page will refresh upon successful submission"
            />
           {% if form.posted_successfully? %}
            <div id="successMessage" class="quote" aria-live="polite" tabindex="-1">
            Thanks for contacting us. We'll get back to you as soon as possible.
            </div>
          {% endif %}
    
          {% if form.errors %}
            <p class="quote" aria-live="assertive" tabindex="-1">
              {{ 'general.forms.post_error' | t }}
            </p>
    
            {% assign message = 'contact.form.message' | t %}
    
            <ul class="center">
              {% for field in form.errors %}
                {% if field == 'form' %}
                  <li>{{ form.errors.messages[field] }}</li>
                {% else %}
                  <li>
                    {% assign field_name = field | replace: 'body', message %}
                    {{ 'general.forms.post_field_error_html' | t: field: field_name, error: form.errors.messages[field] }}
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
            
          </div>
        {% endform %}
                
    
      </div>
    </section>
            </div>
    </div>
    </div>
<style>
        /* === Form Container === */
/* === Form Container === */
.ada-form-is {
  margin: 0 auto !important;
  padding: 4rem 2rem 2rem; /* Added top padding for header spacing */
  max-width: 700px;
  background-color: transparent;
  position: relative;
  z-index: 1;
}
 
/* If your header is fixed, adjust this safely */
body {
  scroll-behavior: smooth;
}
 
/* === Headline === */
h1.waformheading {
  text-align: left;
  font-size: 2.25rem;
  font-weight: 700;
  margin-bottom: 1rem;
  line-height: 1.3;
  color: #2a2a2a;
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}
 
/* === Intro Paragraph === */
.rte > p {
  font-size: 1.05rem;
  margin-bottom: 2rem;
  line-height: 1.6;
  color: #444;
}
 
/* === Labels === */
.waform label {
  display: block;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: #222;
}
 
/* === Input Fields & Textarea === */
.waform input[type="text"],
.waform input[type="email"],
.waform input[type="tel"],
.waform textarea {
  width: 100%;
  padding: 0.875rem 1rem;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 1rem;
  color: #333;
  background-color: #fff;
  margin-top: 0.25rem;
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
  box-sizing: border-box;
}
 
/* === Focus State === */
.waform input:focus,
.waform textarea:focus {
  border-color: #0d6efd;
  box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.25);
  outline: none;
}
 


/* === Textarea === */
.waform textarea {
  resize: vertical;
  min-height: 140px;
  line-height: 1.5;
}
 
/* === Submit Button === */
input.submit.action_button,
input.submit.action_button:hover {
  display: inline-block;
   background-color: #AFAFAF;
  color: #000;
  padding: 0.875rem 1.75rem;
  font-size: 1rem;
  font-weight: 600;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  margin-top: 1.25rem;
  transition: background-color 0.3s ease, transform 0.1s ease-in-out;
}

input.submit.action_button:focus-visible {
  outline: 2px solid #0d6efd;
  box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.3);
}
 

 
input.submit.action_button:active {
  transform: scale(0.98);
}
 
/* === Form Group Spacing === */
.contact__form-name,
.contact__form-email,
.contact__form-phone,
.contact__form-message {
  margin-bottom: 1.75rem;
}
 
/* === Success and Error Messages === */
.quote {
  background-color: #eafbe7;
  border-left: 4px solid #4caf50;
  padding: 1rem;
  margin-top: 1rem;
  border-radius: 4px;
  font-size: 0.95rem;
  color: #222;
}
 
.quote[aria-live="assertive"] {
  background-color: #ffeaea;
  border-left-color: #f44336;
}
 
/* === Responsive Styles === */
 
 
/* Tablets */
@media (max-width: 992px) {
  .ada-form-is {
    padding: 3rem 1.5rem 2rem;
    max-width: 90%;
  }
 
  h1.waformheading {
    font-size: 2rem;
  }
}
 
/* Mobile Devices */
@media (max-width: 600px) {
  .ada-form-is {
    padding: 2rem 1rem;
  }
 
  h1.waformheading {
    font-size: 1.65rem;
  }
 
  .rte > p {
    font-size: 0.95rem;
  }
 
  input.submit.action_button {
    width: 100%;
    padding: 0.9rem;
  }
 
  .waform input,
  .waform textarea {
    font-size: 0.95rem;
  }
}
 
/* Very Small Screens */
@media (max-width: 400px) {
  h1.waformheading {
    font-size: 1.4rem;
  }
}
p#details-issue {
    font-family: AreaWeb, Helvetica, Arial, sans-serif;
    font-weight: 600;
    color: #222;
    font-size: 14px;
    line-height: 24px;
}
</style>
      
    <script>
    document.addEventListener('DOMContentLoaded', function() {
      var successMessage = document.getElementById('successMessage');
      var mainContent = document.getElementById('mainContent');
    
      if (successMessage) {
        setTimeout(function() {
          successMessage.setAttribute('tabindex', '-1');
          successMessage.focus();
          
          // Event listener to move focus back to the main content when user presses Tab or Enter
          {% comment %} successMessage.addEventListener('keydown', function(event) {
            if (event.key === 'Tab' || event.key === 'Enter') {
              mainContent.focus();
            }
          }); {% endcomment %}
        }, 100); // Adding a slight delay to ensure the DOM is fully loaded and focus works correctly
      }
    });
    </script>