<script
  type="application/json"
  data-section-type="map"
  data-section-id="{{ section.id }}"
>
</script>

{%- assign map_overlay_title_id = '' -%}
{%- assign map_overlay_contrast = 'original' -%}
{% for block in section.blocks %}
  {% if block.type == 'guest_service_overlay' %}
    {%- assign map_overlay_contrast = block.settings.caption_content_background | default: 'original' -%}
    {% break %}
  {% endif %}
{% endfor %}

{% capture map_overlay %}
  {% for block in section.blocks %}
    {% if block.type == 'guest_service_overlay' %}
      {%- liquid
        assign guest_hours_any = false
        if block.settings.hours_mon != blank or block.settings.hours_tue != blank or block.settings.hours_wed != blank or block.settings.hours_thu != blank or block.settings.hours_fri != blank or block.settings.hours_sat != blank or block.settings.hours_sun != blank
          assign guest_hours_any = true
        endif
      -%}
      {% if block.settings.heading != blank %}
        {% assign map_overlay_title_id = 'map-guest-title-' | append: block.id %}
      {% endif %}
      <div
        class="guest-service-hours map-section__guest-card map-overlay-contrast--{{ block.settings.caption_content_background | default: 'original' }}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.heading != blank %}
          <h2 class="map-section__guest-title" id="map-guest-title-{{ block.id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.address != blank %}
          <div class="guest-service-hours__row map-section__guest-address-row">
            <span class="guest-service-hours__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" focusable="false">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
            </span>
            <div class="guest-service-hours__body">
              {% capture map_addr_maps_lbl %}{{ 'general.accessibility.map_open_address_maps' | t }}{% endcapture %}
              <a
                href="https://www.google.com/maps/search/?api=1&query={{ block.settings.address | url_encode }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View {{ block.settings.address | strip_newlines | escape }} on Google Maps (opens in a new tab)"
              >{{- block.settings.address | newline_to_br -}}</a>
            </div>
          </div>
          {% if block.settings.phone != blank or block.settings.email != blank or guest_hours_any %}
            <div class="map-section__guest-rule" role="presentation" aria-hidden="true"></div>
          {% endif %}
        {% endif %}

        {% if block.settings.phone != blank %}
          <div class="guest-service-hours__row">
            <span class="guest-service-hours__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" focusable="false">
                <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
              </svg>
            </span>
            <div class="guest-service-hours__body">
              <a href="tel:+1{{ block.settings.phone | strip | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}" aria-label="Call us at: {{ block.settings.phone }}">{{ block.settings.phone }}</a>
            </div>
          </div>
        {% endif %}

        {% if block.settings.email != blank %}
          <div class="guest-service-hours__row">
            <span class="guest-service-hours__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" focusable="false">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
            </span>
            <div class="guest-service-hours__body">
              <a href="mailto:{{ block.settings.email }}" aria-label="Email Address: {{ block.settings.email }}">{{ block.settings.email }}</a>
            </div>
          </div>
        {% endif %}

        {% if guest_hours_any %}
          <div class="guest-service-hours__row">
            <span class="guest-service-hours__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" focusable="false">
                <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>
              </svg>
            </span>
            <div class="guest-service-hours__body">
              <div class="guest-service-hours__grid">
                {% if block.settings.hours_mon != blank %}<span class="guest-service-hours__day">Mon</span><span class="guest-service-hours__time">{{ block.settings.hours_mon }}</span>{% endif %}
                {% if block.settings.hours_tue != blank %}<span class="guest-service-hours__day">Tue</span><span class="guest-service-hours__time">{{ block.settings.hours_tue }}</span>{% endif %}
                {% if block.settings.hours_wed != blank %}<span class="guest-service-hours__day">Wed</span><span class="guest-service-hours__time">{{ block.settings.hours_wed }}</span>{% endif %}
                {% if block.settings.hours_thu != blank %}<span class="guest-service-hours__day">Thu</span><span class="guest-service-hours__time">{{ block.settings.hours_thu }}</span>{% endif %}
                {% if block.settings.hours_fri != blank %}<span class="guest-service-hours__day">Fri</span><span class="guest-service-hours__time">{{ block.settings.hours_fri }}</span>{% endif %}
                {% if block.settings.hours_sat != blank %}<span class="guest-service-hours__day">Sat</span><span class="guest-service-hours__time">{{ block.settings.hours_sat }}</span>{% endif %}
                {% if block.settings.hours_sun != blank %}<span class="guest-service-hours__day">Sun</span><span class="guest-service-hours__time">{{ block.settings.hours_sun }}</span>{% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
{% endcapture %}

{% comment %}
  Pass iframe title and optional guest-service overlay markup into the map snippet.
{% endcomment %}
{% include 'include-map-new', iframe_title: section.settings.map_iframe_title, map_overlay: map_overlay, map_overlay_title_id: map_overlay_title_id, map_overlay_contrast: map_overlay_contrast %}

{% schema %}
{
  "name": "Map",
  "class": "shopify-section--map",
  "settings": [
    {
      "type": "checkbox",
      "id": "map_wide_display",
      "label": "Wide display",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "map_image",
      "label": "Image",
      "info": "Displayed when map isn't loaded"
    },
    {
      "type": "image_picker",
      "id": "map_mobile_image",
      "label": "Mobile Image",
      "info": "900 x 1800px recommended"
    },
    {
      "type": "text",
      "id": "map_image_alt",
      "label": "Map image alt text",
      "info": "Describe the map image for screen readers (e.g., 'Map showing our storefront at 123 Main St.')",
      "default": "Store location map"
    },
    {
      "type": "text",
      "id": "map_address",
      "label": "Address",
      "info": "Google Maps will find the exact location"
    },
    {
      "type": "range",
      "id": "map_height",
      "min": 300,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Map height",
      "default": 400
    },
    {
      "type": "range",
      "id": "zoom_level",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "x",
      "label": "Map zoom level",
      "default": 16
    },
    {
      "type": "header",
      "content": "API key"
    },
    {
      "type": "text",
      "id": "api_key",
      "label": "Google Maps API key",
      "info": "You’ll need to [register a Google Maps API Key](https://help.shopify.com/manual/using-themes/troubleshooting/map-section-api-key) to display the map"
    },
    {
      "type": "checkbox",
      "id": "show_pin",
      "label": "Show pin",
      "info": "Requires use of API key",
      "default": true
    },
    {
      "type": "select",
      "id": "map_style",
      "label": "Map color scheme",
      "info": "Requires use of API key. Warning: High-contrast themes are best for accessibility.",
      "default": "default",
      "options": [
        {
          "value": "aubergine",
          "label": "Aubergine"
        },
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "night",
          "label": "Night"
        },
        {
          "value": "retro",
          "label": "Retro"
        },
        {
          "value": "silver",
          "label": "Silver"
        }
      ]
    },
    {
      "type": "header",
      "content": "Accessibility Settings"
    },
    {
      "type": "text",
      "id": "map_iframe_title",
      "label": "Map iframe title",
      "info": "Briefly describe what this frame contains for screen reader users.",
      "default": "Google Map showing our store location"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "paragraph",
      "content": "[Learn more](https://help.outofthesandbox.com/hc/en-us/articles/360022329373)"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "guest_service_overlay",
      "name": "Guest services overlay",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Text contrast",
          "info": "Improve legibility using the same options as Image with text overlay sections."
        },
        {
          "type": "select",
          "id": "caption_content_background",
          "label": "Contrast technique",
          "default": "original",
          "options": [
            {
              "value": "original",
              "label": "None"
            },
            {
              "value": "darken_bg",
              "label": "Darken banner image"
            },
            {
              "value": "text_box",
              "label": "Solid box"
            },
            {
              "value": "translucent_text_box",
              "label": "Translucent box"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Guest Service Hours"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "info": "Shown above the phone number. Opens in Google Maps when clicked."
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "1-800-253-3663"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "guesthelp@southernseason.com"
        },
        {
          "type": "header",
          "content": "Hours by day"
        },
        {
          "type": "text",
          "id": "hours_mon",
          "label": "Monday",
          "default": "9:00 am to 5:00 pm"
        },
        {
          "type": "text",
          "id": "hours_tue",
          "label": "Tuesday",
          "default": "9:00 am to 5:00 pm"
        },
        {
          "type": "text",
          "id": "hours_wed",
          "label": "Wednesday",
          "default": "9:00 am to 5:00 pm"
        },
        {
          "type": "text",
          "id": "hours_thu",
          "label": "Thursday",
          "default": "9:00 am to 5:00 pm"
        },
        {
          "type": "text",
          "id": "hours_fri",
          "label": "Friday",
          "default": "9:00 am to 5:00 pm"
        },
        {
          "type": "text",
          "id": "hours_sat",
          "label": "Saturday",
          "default": "Closed"
        },
        {
          "type": "text",
          "id": "hours_sun",
          "label": "Sunday",
          "default": "Closed"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Map",
      "category": "Store information",
      "blocks": [
        {
          "type": "guest_service_overlay"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [ "*" ]
  }
}
{% endschema %}