{% comment %}
  @param product {Object}
    The product object

  @param gallery_thumbnails {Boolean}
    If true, show product thumbnails

  @param gallery_thumbnail_slider {Boolean}
    If true, activate thumbnail slider

  @param gallery_click_to_zoom {Boolean}
    If true, enable product lightbox

  @param gallery_hover_zoom {Boolean}
    If true, magnify product images on hover

  @param gallery_arrows {Boolean}
    If true, display slideshow arrows

  @param set_product_height {Boolean}
    If true, set product media height

  @param gallery_slideshow_transition {String}
    Slideshow transition, which is either 'slide' or 'fade'

  @param gallery_slideshow_speed {Number}
    The slideshow speed, which is a range between '0' and '6'

  @param gallery_thumbnail_position {String}
    Thumbnail position, which is either 'below main image', 'left of main image', or 'right of main image'

  @param video_looping {Boolean}
    If true, loop videos

  @param show_only_selected_variant_image {Boolean}
    If true, only show selected variant image
{% endcomment %}

{% liquid
  assign featured_image = product.selected_or_first_available_variant.featured_image | default: product.featured_image
%}

{% style %}
.shopify-model-viewer-ui model-viewer {
  --progress-bar-height: 2px;
  --progress-bar-color: {{ settings.regular_color }};
}
{% endstyle %}

{%- capture ships_free -%}{% render 'ships-free-check', product: product %}{%- endcapture -%}
{%- assign show_freeship_badge = false -%}
{%- if ships_free == 'true' -%}
  {%- assign show_freeship_badge = true -%}
{%- endif -%}

<div
  class="
    gallery-wrap
    gallery-arrows--{{ gallery_arrows }}
    gallery-thumbnails--{{ gallery_thumbnail_position }}
    {% if set_product_height != blank %}
      product-height-set
    {% endif %}
  "
  data-product-gallery-wrapper
  {% if show_only_selected_variant_image %}
    data-show-only-selected-variant-image
  {% endif %}
>
  <div
    class="
      product_gallery
      js-product-gallery
      product-{{ product.id }}-gallery
      transparentBackground--{{ settings.slideshow_button_style }}
      slideshow-transition--{{ gallery_slideshow_transition }}
      popup-enabled--{{ gallery_click_to_zoom }}
      show-gallery-arrows--{{ gallery_arrows }}
      {% if product.media.size > 1 %}
        multi-image
      {% else %}
        single-image
      {% endif %}
    "
    data-product-gallery
    data-thumbnails-enabled="{{ gallery_thumbnails }}"
    data-gallery-arrows-enabled="{{ gallery_arrows }}"
    data-slideshow-speed="{{ gallery_slideshow_speed }}"
    data-thumbnails-position="{{ gallery_thumbnail_position }}"
    data-thumbnails-slider-enabled="{{ gallery_thumbnail_slider }}"
    data-zoom="{{ gallery_hover_zoom }}"
    data-video-loop="{{ video_looping }}"
    data-product-id="{{ product.id }}"
    data-product-lightbox="{{ gallery_click_to_zoom }}"
    data-media-count="{{ product.media.size }}"
  >
    {% for media in product.media %}
      {% liquid
        assign linked_variant_media = false
        for variant in product.variants
          if variant.featured_media.id == media.id
            assign linked_variant_media = true
          endif
        endfor

        assign media_alt = media.alt | default: product.title | escape
        assign image_5000x = media | image_url: width: 5000
      %}

      <div
        class="gallery-cell"
        data-product-gallery-media
        data-media-id="{{ media.id }}"
        data-media-variant-image="{{ linked_variant_media }}"
        data-product-id="{{ product.id }}"
        data-thumb="{{ media | image_url: width: 800 }}"
        data-media-type="
          {% if media_alt contains 'youtube' or media_alt contains 'vimeo' %}
            external_video
          {% else %}
            {{ media.media_type }}
          {% endif %}
        "
        data-title="
          {% if media_alt contains 'youtube' or media_alt contains 'vimeo' %}
            {{ product.title | escape }}
          {% else %}
            {{ media_alt }}
          {% endif %}
        "
      >
        {% case media.media_type %}
          {% when 'image' %}
            {% if media_alt contains 'youtube' or media_alt contains 'vimeo' %}
              {% assign alt_text = media_alt | split: ' ' %}
              {% for property in alt_text %}
                {% if property contains "src" %}
                  {% assign cleanURL = property | remove: 'src=' | remove: '&quot;' | remove: '"' %}
                  <div class="product-gallery__video" data-youtube-video>
                    {% comment %} Accessible Fix: Added iframe title for screen readers {% endcomment %}
                    <iframe src="{{ cleanURL }}" frameborder="0" title="Product video for {{ product.title | escape }}"></iframe>
                  </div>
                {% endif %}
              {% endfor %}
            {% else %}
              {% if gallery_click_to_zoom and product.images.size > 0 %}
                {% comment %} Accessible Fix: Added ARIA label to prevent link outputting messy raw URL strings to screen readers if focused {% endcomment %}
                <a
                  class="lightbox"
                  href="{{ image_5000x }}"
                  data-fancybox="{{ product.id }}"
                  rel="product-lightbox"
                  tabindex="-1"
                  aria-label="Enlarge product image"
                >
              {% endif %}

              <div class="image__container" style="max-width: {{ media.width }}px">
                {% if product.images.size > 0 %}
                  {%- liquid
                    assign lazyload = 'lazy'
                    if section.index0 < 2 and forloop.first
                      assign lazyload = 'eager'
                    endif
                  -%}

                  {{ media 
                    | image_url: width: 1200 
                    | image_tag:
                      loading: lazyload,
                      class: 'product-gallery__image',
                      alt: media_alt,
                      width: media.width,
                      height: media.height,
                      data-image-id: media.id,
                      data-index: forloop.index0,
                      data-zoom-src: image_5000x
                  }}
                {% else %}
                  {% comment %} Accessible Fix: Prevented empty alt falling through if featured image lacks one {% endcomment %}
                  {% assign backup_alt = featured_image.alt | default: product.title | escape %}
                  <img src="{{ featured_image | image_url: width: 1200 }}" alt="{{ backup_alt }}" />
                {% endif %}

                {% if show_freeship_badge %}
                  <img
                    class="product-badge--freeship"
                    src="{{ 'shipfree-badge.png' | asset_url }}"
                    alt="{% if forloop.first %}Ships free{% endif %}"
                    width="400"
                    height="362"
                    loading="lazy"
                  >
                {% endif %}
              </div>

              {% if gallery_click_to_zoom and product.images.size > 0 %}
                </a>
              {% endif %}
            {% endif %}

          {% when 'external_video' %}
            <div class="product-gallery__video" data-youtube-video>
              {% comment %} 
                Using Shopify's standard video tags can automatically handle accessibility if they push an iframe. 
                However, appending a clean fallback label title directly on standard embeds can't hurt if custom code takes over.
              {% endcomment %}
              {{ media | external_video_tag: title: product.title }}
            </div>

          {% when 'video' %}
            <div class="product-gallery__video" data-html5-video>
              {{ media | video_tag: controls: true }}
            </div>

          {% when 'model' %}
            <div class="product-gallery__model">
              {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true, image_size: '800x800' }}

              <button
                class="view-in-your-space"
                data-shopify-xr
                data-shopify-model3d-id="{{ media.id }}" 
                data-shopify-title="{{ product.title | escape }}"
                style="display: none;"
              >
                <svg width="33" height="33" viewBox="0 0 33 33" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M16 9L22.0622 12.5V19.5L16 23L9.93782 19.5V12.5L16 9Z" stroke="#3A3A3A" stroke-width="1.5"/>
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M16 23V15.6024C16.6225 15.2002 16.6225 15.2002 16.6225 15.2002L22 12V19.4082L16 23Z" fill="#3A3A3A"/>
                </svg>
                {{ 'products.product.view_in_your_space' | t | capitalize }}
              </button>
            </div>
          {% else %}
            {{ media | media_tag }}
        {% endcase %}
      </div>
    {% endfor %}
  </div>

  {% if gallery_thumbnails == true %}
    {% if image_width != 'full' %}
      <div
        class="
          product_gallery_nav
          product_gallery_nav--{{ gallery_thumbnail_position }}
          product-{{ product.id }}-gallery-nav
          product-gallery__thumbnails
          {% unless gallery_thumbnail_slider %}
            product_gallery_nav--slider-enabled
          {% endunless %}
        "
        data-product-gallery-thumbnails
      >
        {% if product.media.size > 1 %}
          {% for media in product.media %}
            {% liquid
              assign media_type = media.media_type

              assign linked_variant_media = false
              for variant in product.variants
                if variant.featured_media.id == media.id
                  assign linked_variant_media = true
                endif
              endfor

              case media_type
                when 'video'
                  assign thumbnail_badge = 'video-thumbnail'
                when 'model'
                  assign thumbnail_badge = '3d-thumbnail'
                else
                  assign thumbnail_badge = ''
              endcase
              
              assign thumb_alt = media.alt | default: product.title | escape
            %}

            {% comment %} Accessible Fix: Added role="button" and aria-label to thumb controls {% endcomment %}
            <div
              class="gallery-cell"
              data-title="{{ thumb_alt }}"
              data-media-id="{{ media.id }}"
              data-media-variant-image="{{ linked_variant_media }}"
              tabindex="0"
              role="button"
              aria-label="View slide {{ forloop.index }} - {{ thumb_alt }}"
            >
              {% render 'image-element', image: media, alt: thumb_alt %}

              {% if thumbnail_badge == 'video-thumbnail' %}
                <svg class="media-badge" width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M1 25H25V1H1V25Z" fill="white"/>
                  <path class="media-badge__outline" d="M0.5 25V25.5H1H25H25.5V25V1V0.5H25H1H0.5V1V25Z" stroke="black" stroke-opacity="0.05"/>
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M8.19995 5.8V20.2L19.3999 12.5858L8.19995 5.8Z" fill="#3A3A3A" fill-opacity="0.6"/>
                </svg>
              {% elsif thumbnail_badge == '3d-thumbnail' %}
                <svg class="media-badge" width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M1 25H25V1H1V25Z" fill="white"/>
                  <path class="media-badge__outline" d="M0.5 25V25.5H1H25H25.5V25V1V0.5H25H1H0.5V1V25Z" stroke="black" stroke-opacity="0.05"/>
                  <g opacity="0.6">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M13 6L19.0622 9.5V16.5L13 20L6.93782 16.5V9.5L13 6Z" stroke="#3A3A3A" stroke-width="1.5"/>
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M13 20V12.6024C13.6225 12.2002 13.6225 12.2002 13.6225 12.2002L19 9V16.4082L13 20Z" fill="#3A3A3A"/>
                  </g>
                </svg>
              {% endif %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    {% endif %}
    {% endif %}
</div>