{%- capture _ -%}
  {% comment %}
    This adjusts the color to give it an appropriate difference from the original color.
    It is usually used for link hover color, and things where we need to distinguish a change.

    @param morph_base_color {Color}
      The origin color to morph

    @param morph_adjustment {Number}
      The number to multiply the lightness and saturation by. Default 1.5 (Reduced from 2 for accessibility).
  {% endcomment %}

  {% if morph_adjustment == blank %}
    {% comment %} 
      Accessibility Fix: Lowered default from 2 to 1.2 to prevent massive 
      contrast-breaking shifts in background colors.
    {% endcomment %}
    {% assign morph_adjustment = 1.2 %}
  {% endif %}

  {% assign morph_adjustment = morph_adjustment | times: 1.0 %}
  {% assign color_lightness = morph_base_color | color_extract: 'lightness' %}

  {% if color_lightness > 20.0 %}
    {% if color_lightness > 50.0 %}
      {% assign light_adjustment = color_lightness | divided_by: 25.0 | times: morph_adjustment %}
    {% else %}
      {% assign light_adjustment = color_lightness | divided_by: 15.0 | times: morph_adjustment %}
    {% endif %}
    
    {% comment %} 
      If background is light, darkening on hover usually IMPROVES contrast 
      against light text, or barely harms contrast against dark text.
    {% endcomment %}
    {% assign new_color = morph_base_color | color_darken: light_adjustment %}

  {% else %}
    {% comment %} 
      CRITICAL ACCESSIBILITY FIX: 
      When a color has < 20% lightness, it's very dark. Lightening it too much 
      destroys contrast against white text. We cap the maximum lightening effect.
    {% endcomment %}
    
    {% if color_lightness < 7.0 %}
      {% assign light_adjustment = 1.5 | times: morph_adjustment %}
      {% assign new_color = morph_base_color | color_desaturate: 10.0 %}
    {% elsif color_lightness < 12.0 %}
      {% assign light_adjustment = 1.2 | times: morph_adjustment %}
      {% assign new_color = morph_base_color | color_desaturate: 5.0 %}
    {% else %}
      {% assign light_adjustment = 1.0 | times: morph_adjustment %}
      {% assign new_color = morph_base_color %}
    {% endif %}

    {% comment %} Capped the lightening to a maximum of 10% to preserve contrast {% endcomment %}
    {% if light_adjustment > 10.0 %}
      {% assign light_adjustment = 10.0 %}
    {% endif %}

    {% assign new_color = new_color | color_lighten: light_adjustment %}
  {% endif %}

  {% assign morph_base_color = blank %}
  {% assign morph_adjustment = blank %}
{%- endcapture -%}
{{ new_color }}