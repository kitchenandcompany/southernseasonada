{%- liquid
  assign card_media = product.featured_media
  for media_item in product.media
    if media_item.media_type == 'image'
      assign media_src = media_item.preview_image.src | split: '?' | first | downcase
      if media_src contains '.png'
        assign card_media = media_item
        break
      endif
    endif
  endfor
  assign secondaryImage = product.media[1]
  if card_media.id != product.featured_media.id
    assign secondaryImage = product.featured_media
  endif
-%}
{%- assign collection_handles = product.collections | map: 'handle' -%}
{%- assign product_heading_id = 'product-thumb-title-' | append: section.id | append: '-' | append: product.id -%}
{%- assign product_tags_downcased = product.tags | join: '|' | downcase | split: '|' -%}

{% if product.featured_media.preview_image.alt contains 'youtube' or image.alt contains 'vimeo' %}
  {%- assign alt_text = product.title | escape -%}
{% else %}
  {%- assign alt_text = card_media.preview_image.alt | default: product.title | escape -%}
{% endif %}

<div
  class="
    {%
      render 'column-width',
      value: products_per_row
    %}
    column
    thumbnail
    thumbnail-hover-enabled--{{ settings.thumbnail_hover_enabled }}
    {% if settings.mobile_products_per_row == '1' %}
      medium-down--one-half
      small-down--one-whole
    {% else %}
      medium-down--one-half
    {% endif %}
    {% if settings.quick_shop_enabled %}
      quick-shop-style--{{ settings.quick_shop_style }}
      product__details
    {% endif %}
  "
  {% if settings.pagination_type != 'basic_pagination' %}
    data-load-more--grid-item
  {% endif %}
  role="listitem"
  {% comment %} aria-labelledby="{{ product_heading_id }}" {% endcomment %}
>
{% comment %} <h2 id="{{ product_heading_id }}" class="visually-hidden">{{ product.title | escape }}</h2> {% endcomment %}
<div class="product-{{ product.id }}">
  <div class="product-wrap {% if settings.collection_secondary_image != blank and secondaryImage != blank %}has-secondary-media-swap{% endif %}">
    <div class="relative product_image">
      <a href="{{ product.url | within: collection }}" role="presentation" tabindex="-1" aria-hidden="true">
        <div class="image__container">
          {% if settings.product_form_style == 'select' %}
            {%
              render 'quick-shop-gallery',
              product: product,
            %}
          {% else %}
            {% if settings.quick_shop_enabled and settings.quick_shop_style == 'inline' and product.selected_or_first_available_variant.image %}
              {%
                render 'image-element',
                image: product.selected_or_first_available_variant.image,
                alt: alt_text,
                lazyload: lazyload,
                object_fit: align_height,
                max_height: collection_height,
              %}
            {% else %}
              {%
                render 'image-element',
                image: card_media.preview_image,
                alt: alt_text,
                lazyload: lazyload,
                object_fit: align_height,
                max_height: collection_height,
              %}
            {% endif %}
          {% endif %}
        </div>

        {% if settings.collection_secondary_image != blank and secondaryImage != blank %}
          {% if secondaryImage.media_type == 'external_video' %}
            <div
              class="
                external-video__container
                {% if section.index0 < 2 %}lazyload{% else %}lazypreload{% endif %}
                secondary-media-hidden
                video-on-hover
              "
            >
              <div class="youtube-wrapper" data-youtube-video>
                {{ secondaryImage | external_video_tag }}
              </div>
            </div>
          {% elsif secondaryImage.media_type == 'video' %}
            <div class="video__container lazyload lazypreload secondary-media-hidden video-on-hover" data-html5-video>
              {{ secondaryImage | video_tag: controls: false }}
            </div>
          {% else %}
            {%
              render 'image-element',
              image: secondaryImage.preview_image,
              alt: alt_text,
              additional_classes: 'secondary lazypreload secondary-media-hidden',
            %}
          {% endif %}
        {% endif %}
      </a>

      {% if product_tags_downcased contains 'freeship' %}
        <img
          class="product-badge--freeship"
          src="{{ 'shipfree-badge.png' | asset_url }}"
          alt="Ships free"
          width="400"
          height="362"
          loading="lazy"
        >
      {% endif %}
    </div>

    {%
      render 'product-details',
      product: product,
      collection: collection,
      collection_handles: collection_handles,
    %}
  </div>
</div>

  <a class="product-info__caption {% if settings.thumbnail_hover_enabled %}hidden{% endif %}" aria-label="{{- product.title | escape -}}" href="{{ product.url | within: collection }}">
    {%
      render 'product-info',
      product: product,
      collection_handles: collection_handles,
    %}
  </a>

{% render 'product-info-price',
  product: product,
  variant: variant,
  collection_handles: collection_handles
%}
  
  {% unless settings.quick_shop_style == 'inline' and settings.quick_shop_enabled %}
    {%
      render 'collection-swatch',
      product: product,
    %}
  {% endunless %}

  {% if settings.quick_shop_style == 'inline' and settings.quick_shop_enabled %}
    {% unless collection_handles contains 'coming-soon' %}
      <div
        class="
          inline-quickshop
          js-product-section
          product-{{ product.id }}
        "
      >
        {%
          render 'product-form',
          product: product,
          show_payment_button: settings.show_dynamic_checkout_button,
          collection_handles: collection_handles,
        %}
      </div>
    {% endunless %}
  {% endif %}
</div>
