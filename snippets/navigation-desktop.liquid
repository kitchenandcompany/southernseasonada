{% comment %}
  @param menu [Linklist]
    Menu to render
  @param style [String]
    Menu style to render. One of `wide` or `vertical`.
  @param additional_class [Optional]
    Additional classes for the component
  @param menu_label [String]
    Optional. Navigation menu name (usually the link list title from the admin) for the nav landmark.
{% endcomment %}
{%- assign menu_label = menu_label | default: '' | strip -%}
{%- if menu_label != blank -%}
  {%- assign nav_desktop_aria = menu_label -%}
{%- else -%}
  {%- capture t_nh_mn -%}{{ 'navigation.header.main_nav' | t }}{%- endcapture -%}
  {%- capture nav_desktop_aria -%}{% render 'a11y-missing-fallback', text: t_nh_mn, fallback: 'Main menu' %}{%- endcapture -%}
{%- endif -%}
{%- capture t_nh_sub -%}{{ 'navigation.header.submenu' | t }}{%- endcapture -%}
{%- capture subnav_word -%}{% render 'a11y-missing-fallback', text: t_nh_sub, fallback: 'submenu' %}{%- endcapture -%}

<nav
  class="nav-desktop {{ additional_class }}"
  data-nav
  data-nav-desktop
  aria-label="Primary"
>
  {% comment %} 
    The Template tag content will be parsed by JS. We've ensured that 
    the aria relationships are ready for execution.
  {% endcomment %}
  <template data-nav-parent-template>
    <li
      class="nav-desktop__tier-1-item nav-desktop__tier-1-item--widemenu-parent"
      data-nav-desktop-parent
    >
      <details data-nav-desktop-details>
        <summary
          class="nav-desktop__tier-1-link nav-desktop__tier-1-link--parent"
          data-nav-desktop-link
          {% comment %} aria-haspopup="true" {% endcomment %}
        >
          <span data-nav-title></span>
          <span class="icon-down-arrow" aria-hidden="true"></span>
        </summary>
        <div
          class="nav-desktop__tier-2 nav-desktop__tier-2--full-width-menu"
          tabindex="-1"
          data-nav-desktop-tier-2
          data-nav-desktop-submenu
          data-nav-desktop-full-width-menu
          data-meganav-target-container
          role="group"
          aria-label="{{ subnav_word | escape }}"
        >
        </div>
      </details>
    </li>
  </template>

  <ul
    class="nav-desktop__tier-1"
    data-nav-desktop-tier-1
  >
    {% for link_tier_1 in linklists[menu].links %}
      {% assign has_tier_2 = false %}
      {% if link_tier_1.links.size > 0 %}
        {% assign has_tier_2 = true %}
      {% endif %}

      <li
        class="
          nav-desktop__tier-1-item
          {% if has_tier_2  %}
            {% if style == 'wide' %}
              nav-desktop__tier-1-item--widemenu-parent
            {% else %}
              nav-desktop__tier-1-item--dropdown-parent
            {% endif %}
          {% endif %}
        "
        {% if has_tier_2 %}data-nav-desktop-parent{% endif %}
        data-meganav-desktop-target="{{ link_tier_1.title | handle }}"
      >
        {% if has_tier_2 %}
          <details data-nav-desktop-details>
            <summary 
              class="nav-desktop__tier-1-link nav-desktop__tier-1-link--parent"
              data-nav-desktop-link
              {% comment %} aria-haspopup="true" {% endcomment %}
            >
              <span data-nav-title>{{ link_tier_1.title | escape }}</span>
              <span class="icon-down-arrow" aria-hidden="true"></span>
            </summary>
        {% else %}
          {% comment %} True anchor links are natively accessible. {% endcomment %}
          <a href="{{ link_tier_1.url }}"
             class="nav-desktop__tier-1-link {% if link_tier_1.active %}nav-desktop__tier-1-link--active{% endif %}"
             data-nav-desktop-link
          >
            <span data-nav-title>{{ link_tier_1.title | escape }}</span>
          </a>
        {% endif %}

        {% if has_tier_2 %}
          {% comment %}
            To ensure screen readers track the context correctly, we preserve lists 
            or supply clean group labels if a non-semantic div takes over.
          {% endcomment %}
          {% if style == 'wide' %}
            <div role="group" 
                 aria-label="{{ link_tier_1.title | escape }} {{ subnav_word | escape }}"
          {% else %}
            <ul aria-label="{{ link_tier_1.title | escape }} {{ subnav_word | escape }}"
          {% endif %}
              id="nav-tier-2-{{ forloop.index }}"
              class="
                nav-desktop__tier-2
                {% if style == 'wide' %}
                  nav-desktop__tier-2--full-width-menu
                {% else %}
                  nav-desktop__tier-2--dropdown
                {% endif %}
              "
              tabindex="-1"
              data-nav-desktop-tier-2
              data-nav-desktop-submenu
              {% if style == 'wide' %}data-nav-desktop-full-width-menu{% endif %}
            >
              
              {% if style == 'wide' %}
                {%
                  render 'navigation-widemenu',
                  menu: link_tier_1,
                %}
              {% else %}
                {% assign tier_1_index = forloop.index %}
                {% for link_tier_2 in link_tier_1.links %}
                  {% assign has_tier_3 = false %}
                  {% if link_tier_2.links.size > 0 %}
                    {% assign has_tier_3 = true %}
                  {% endif %}

                  <li class="nav-desktop__tier-2-item" {% if has_tier_3 %}data-nav-desktop-parent{% endif %}>
                    
                    {% if has_tier_3 %}
                      <details data-nav-desktop-details>
                        <summary 
                          class="nav-desktop__tier-2-link nav-desktop__tier-2-link--parent"
                          data-nav-desktop-link
                          aria-haspopup="true"
                        >
                          <span>{{ link_tier_2.title | escape }}</span>
                          <span class="nav-desktop__tier-2-link-icon icon-down-arrow" aria-hidden="true"></span>
                        </summary>
                    {% else %}
                      <a href="{{ link_tier_2.url }}"
                         class="nav-desktop__tier-2-link"
                         data-nav-desktop-link
                      >
                        <span>{{ link_tier_2.title | escape }}</span>
                      </a>
                    {% endif %}

                    {% if has_tier_3 %}
                      {%- capture t_tier3_aria -%}{{ 'navigation.header.submenu_for' | t: name: link_tier_2.title }}{%- endcapture -%}
                      {%- assign tier3_fb = link_tier_2.title | append: ' — submenu' -%}
                      {%- capture tier3_aria -%}{% render 'a11y-missing-fallback', text: t_tier3_aria, fallback: tier3_fb %}{%- endcapture -%}
                      <ul
                        id="nav-tier-3-{{ tier_1_index }}-{{ forloop.index }}"
                        class="nav-desktop__tier-3"
                        tabindex="-1"
                        data-nav-desktop-tier-3
                        data-nav-desktop-submenu
                        aria-label="{{ tier3_aria | escape }}"
                      >
                        {% for link_tier_3 in link_tier_2.links %}
                          <li class="nav-desktop__tier-3-item">
                            <a href="{{ link_tier_3.url }}" class="nav-desktop__tier-3-link">
                              <span>{{ link_tier_3.title | escape }}</span>
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                      </details>
                    {% endif %}
                    
                  </li>
                {% endfor %}
              {% endif %}
              
          {% if style == 'wide' %}
            </div>
          {% else %}
            </ul>
          {% endif %}
          
          </details>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>