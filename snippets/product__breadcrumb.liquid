<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@id": "{{ shop.url }}",
          "name": "{{ 'general.breadcrumbs.home' | t }}"
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          {% if collection %}
            "@id": "{{ collection.url }}",
            "name": "{{ collection.title }}"
          {% else %}
            "@id": "{{ routes.all_products_collection_url }}",
            "name": "{{ collections.all.title }}"
          {% endif %}
        }
      },
      {
        "@type": "ListItem",
        "position": 3,
        "item": {
          "@id": "{{ product.url }}",
          "name": "{{ product.title | escape }}"
        }
      }
    ]
  }
</script>

{% comment %}
  Fix 1: Wrapped the breadcrumbs in a <nav> landmark with an aria-label.
  Fix 2: Converted the breadcrumbs into an ordered list (<ol>), which tells screen 
  readers exactly how many steps are in the trail.
{% endcomment %}
{% capture a11y_breadcrumb %}{{ 'general.accessibility.breadcrumb' | t }}{% endcapture %}
<nav class="breadcrumb_text" aria-label="{% render 'a11y-missing-fallback', text: a11y_breadcrumb, fallback: 'Breadcrumb' %}">
  <ol style="list-style: none; display: flex; align-items: center; padding: 0; margin: 0;">
    
    <li style="display: inline-flex; align-items: center;">
      {% comment %} Fix 3: Removed redundant 'title' attributes that duplicated inner text {% endcomment %}
      <a href="{{ routes.root_url }}" class="breadcrumb_link">
        <span>{{ 'general.breadcrumbs.home' | t }}</span>
      </a>
      {% comment %} Fix 4: Hidden the visual divider from screen readers {% endcomment %}
      <span class="breadcrumb-divider" aria-hidden="true" style="margin: 0 8px;">/</span>
    </li>

    <li style="display: inline-flex; align-items: center;">
      {% if collection %}
        <a href="{{ collection.url }}" class="breadcrumb_link">
          <span>{{ collection.title }}</span>
        </a>
      {% else %}
        <a href="{{ routes.all_products_collection_url }}" class="breadcrumb_link">
          <span>{{ collections.all.title }}</span>
        </a>
      {% endif %}
      <span class="breadcrumb-divider" aria-hidden="true" style="margin: 0 8px;">/</span>
    </li>

    <li style="display: inline-flex; align-items: center;">
      {% comment %} 
        Fix 5: Removed the active link for the current page.
        Fix 6: Added aria-current="page" to let screen readers know this is where the user is at.
      {% endcomment %}
      <span class="breadcrumb_link breadcrumb_link--current" aria-current="page">
        {{ product.title | escape }}
      </span>
    </li>

  </ol>
</nav>