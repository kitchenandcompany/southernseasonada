      <a href="https://kitchenandcompany.com/pages/accessibility" class="skip-to-content-link visually-hidden-link">Go to Accessibility Statement</a>
    </div>

    <script>
      document.documentElement.className=document.documentElement.className.replace(/\bno-js\b/,'js');
