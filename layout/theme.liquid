    <script>(function(n, v) {/* eslint-disable-next-line max-len */if (window.Shopify && window.Shopify.theme && navigator && navigator.sendBeacon && window.Shopify.designMode) {if (sessionStorage.getItem('oots_beacon')) return;navigator.sendBeacon('https://app.outofthesandbox.com/beacon', new URLSearchParams({shop_domain: window.Shopify.shop.toLowerCase(),shop_id: window.BOOMR.shopId,shop_email: '{{ shop.email }}',theme_name: n.toLowerCase(),theme_version: v.toLowerCase(),theme_store_id: window.Shopify.theme.theme_store_id,theme_id: window.Shopify.theme.id,theme_role: window.Shopify.theme.role,}));sessionStorage.setItem('oots_beacon', '');}}('turbo','9.5.2'))</script>
    <script>
      //For Quick View button focus triggering
      (function () {
  function init() {
    var lastTrigger = null;

    // Use CAPTURE phase (true) so this runs even if the theme's own
    // handler calls stopPropagation() on the click/keydown event.
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('.js-quick-shop-link');
      if (trigger) {
        lastTrigger = trigger;
      }
    }, true);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        var trigger = e.target.closest('.js-quick-shop-link');
        if (trigger) {
          lastTrigger = trigger;
        }
      }
    }, true);

    function returnFocus() {
      if (lastTrigger && document.body.contains(lastTrigger)) {
        setTimeout(function () {
          lastTrigger.focus();
        }, 0);
      }
    }

    if (window.jQuery && jQuery.fancybox) {
      jQuery(document).on('afterClose.fb', returnFocus);
    }

    if (window.Fancybox) {
      Fancybox.bind('[data-fancybox]', {
        on: { destroy: returnFocus }
      });
    }

    var observer = new MutationObserver(function (mutations) {
      mutations.forEach(function (m) {
        m.removedNodes.forEach(function (node) {
          if (
            node.nodeType === 1 &&
            (node.classList.contains('fancybox-container') ||
              (node.querySelector && node.querySelector('.fancybox-container')))
          ) {
            returnFocus();
          }
        });
      });
    });
    observer.observe(document.body, { childList: true });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && document.querySelector('.fancybox-container')) {
        returnFocus();
      }
    }, true);

    document.addEventListener('click', function (e) {
      var closeBtn = e.target.closest('.fancybox-close-small');
      if (closeBtn) {
        returnFocus();
      }
    }, true);
  }

  // Run immediately if DOM is already parsed (covers deferred/late-loaded
  // scripts where DOMContentLoaded has already fired), otherwise wait for it.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

//Cookie Consent Popup
(function () {
  var bannerSelector = '#shopify-pc__banner';
  var acceptSelector = '#shopify-pc__banner__btn-accept';
  var declineSelector = '#shopify-pc__banner__btn-decline';
  var focusTrapHandler = null;
  var closing = false;

  function getBanner() {
    return document.querySelector(bannerSelector);
  }

  function getFocusableElements(banner) {
    return Array.from(
      banner.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )
    ).filter(function (el) {
      return el.offsetParent !== null;
    });
  }

  function enableFocusTrap(banner) {
    if (focusTrapHandler || closing) {
      return;
    }

    focusTrapHandler = function (event) {
      if (event.key !== 'Tab' || closing) {
        return;
      }

      var focusable = getFocusableElements(banner);

      if (!focusable.length) {
        event.preventDefault();
        banner.focus();
        return;
      }

      var first = focusable[0];
      var last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    banner.addEventListener('keydown', focusTrapHandler);
  }

  function disableFocusTrap(banner) {
    closing = true;

    if (banner && focusTrapHandler) {
      banner.removeEventListener('keydown', focusTrapHandler);
    }

    focusTrapHandler = null;

    // Important: no longer treat the banner as modal
    if (banner) {
      banner.setAttribute('aria-modal', 'false');
    }
  }

  function moveFocusToSkipLinks() {
    var topBack = document.getElementById('top-back');

    if (!topBack) {
      return;
    }

    // Wait until Shopify has finished closing the cookie banner.
    var attempts = 0;
    var maxAttempts = 30;

    function tryFocus() {
      attempts++;

      var banner = getBanner();

      var bannerClosed =
        !banner ||
        banner.style.display === 'none' ||
        banner.hidden ||
        !document.body.contains(banner);

      if (bannerClosed || attempts >= maxAttempts) {
        topBack.focus();
        return;
      }

      setTimeout(tryFocus, 100);
    }

    tryFocus();
  }

  function setupBanner(banner) {
    if (!banner || banner.dataset.cookieFocusTrap === 'true') {
      return;
    }

    banner.dataset.cookieFocusTrap = 'true';

    // Make cookie banner modal
    banner.setAttribute('aria-modal', 'true');

    enableFocusTrap(banner);

    var acceptButton = banner.querySelector(acceptSelector);
    var declineButton = banner.querySelector(declineSelector);

    [acceptButton, declineButton].forEach(function (button) {
      if (!button) {
        return;
      }

      button.addEventListener('click', function () {
        // Disable trap BEFORE Shopify processes the button.
        disableFocusTrap(banner);

        // Let Shopify finish its cookie-consent action,
        // then move focus to the helpful links.
        moveFocusToSkipLinks();
      });
    });
  }

  function init() {
    var banner = getBanner();

    if (!banner || banner.style.display === 'none') {
      return;
    }

    setupBanner(banner);
  }

  init();

  // Shopify can inject/update the banner dynamically.
  var observer = new MutationObserver(function () {
    if (!closing) {
      init();
    }
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
})();

</script>
